# Copy to apps/student-mobile/.env (git-ignored) and adjust for your machine.
# Metro inlines EXPO_PUBLIC_* values when the bundle is built — restart `npx expo start -c` after changing them.

# Local student-web API (npm run dev:student → http://localhost:3002)
#   Expo web / iOS simulator: http://localhost:3002/api/v1
#   Android emulator:         http://10.0.2.2:3002/api/v1
#   Physical device:          http://<your-computer-LAN-IP>:3002/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3002/api/v1

# Student web portal (wallet top-up, live classroom, FAQ/Terms/Privacy)
EXPO_PUBLIC_STUDENT_WEB_URL=http://localhost:3002

# Public site (student sign-up, forgot password) — teacher-web
EXPO_PUBLIC_PUBLIC_SITE_URL=http://localhost:3000
