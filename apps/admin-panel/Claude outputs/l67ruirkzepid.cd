## Additional High\-Priority Fixes {#additional-high-priority-fixes}

### Fix 7: Rate Limiter Memory Leak {#fix-7-rate-limiter-memory-leak}

**File:** `src/lib/rate-limit.ts` (lines 43\-58)

Replace `rateLimitInMemory` function:

```typescript
function rateLimitInMemory(key: string, opts: RateLimitOptions): RateLimitResult {
  const now = Date.now();
  let bucket = buckets.get(key);

  // Clean up expired buckets to prevent memory leak
  if (bucket && bucket.resetAt <= now) {
    buckets.delete(key);
    bucket = undefined;
  }

  if (!bucket) {
    buckets.set(key, { count: 1, resetAt: now + opts.windowMs });
    return { ok: true, retryAfterMs: 0 };
  }

  if (bucket.count >= opts.limit) {
    return { ok: false, retryAfterMs: bucket.resetAt - now };
  }

  bucket.count += 1;
  return { ok: true, retryAfterMs: 0 };
}

// Periodically clean up expired buckets (add this near the end of the file)
setInterval(() => {
  const now = Date.now();
  let cleaned = 0;
  for (const [key, bucket] of buckets.entries()) {
    if (bucket.resetAt <= now) {
      buckets.delete(key);
      cleaned++;
    }
  }
  if (cleaned > 0) {
    console.log(`[rate-limit] Cleaned up ${cleaned} expired buckets`);
  }
}, 60000); // Clean every minute
```

