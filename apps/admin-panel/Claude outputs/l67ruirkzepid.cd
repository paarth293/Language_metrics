## Fix 1: Rate Limiter Fail\-Closed in Production {#fix-1-rate-limiter-fail-closed-in-production}

**File:** `src/lib/rate-limit.ts`

### Current Code (DANGEROUS) {#current-code-dangerous}

Replace lines 85\-120 with:

### Fixed Code {#fixed-code}

```typescript
export async function rateLimit(
  key: string,
  opts: RateLimitOptions
): Promise<RateLimitResult> {
  const client = getClient();
  
  // If Redis is unavailable in production, fail CLOSED (reject requests)
  if (!client) {
    if (process.env.NODE_ENV === "production") {
      console.error(
        "[rate-limit] Redis unavailable in production. Rate limiting disabled.",
        `Rejecting requests for key: ${key}`
      );
      return { ok: false, retryAfterMs: 60000 };
    }
    // Allow in-memory fallback only for local development
    console.warn(
      "[rate-limit] Redis unavailable. Using in-memory limiter (dev only)."
    );
    return rateLimitInMemory(key, opts);
  }

  try {
    const now = Date.now();
    const windowStart = now - opts.windowMs;
    const redisKey = `rl:admin:${key}`;

    const pipeline = client.pipeline();
    pipeline.zremrangebyscore(redisKey, "-inf", windowStart);
    pipeline.zadd(redisKey, now, `${now}-${Math.random()}`);
    pipeline.zcard(redisKey);
    pipeline.pexpire(redisKey, opts.windowMs);
    const results = await pipeline.exec();

    const count = (results?.[2]?.[1] as number) ?? 0;
    if (count > opts.limit) {
      const oldest = await client.zrange(redisKey, 0, 0, "WITHSCORES");
      const oldestTs = oldest?.[1] ? Number(oldest[1]) : now;
      return { ok: false, retryAfterMs: Math.max(0, oldestTs + opts.windowMs - now) };
    }
    return { ok: true, retryAfterMs: 0 };
  } catch (err) {
    console.error("[rate-limit] Redis error during rate limit check:", err);
    if (process.env.NODE_ENV === "production") {
      // Fail closed in production
      console.error("[rate-limit] Failing closed: rejecting request");
      return { ok: false, retryAfterMs: 60000 };
    }
    // Fail open in dev
    console.warn("[rate-limit] Failing open in dev mode");
    return { ok: true, retryAfterMs: 0 };
  }
}
```

