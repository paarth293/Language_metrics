### Fix 8: Add Password Expiration Policy {#fix-8-add-password-expiration-policy}

**File:** `src/lib/guards.ts`

Replace the `requireAdmin` function:

```typescript
export const requireAdmin = cache(async (): Promise<SessionUser> => {
  const session = await readSession();
  if (!session) redirect("/login");

  const admin = await db.adminUser.findUnique({
    where: { userId: session.sub },
    select: {
      userId: true,
      name: true,
      email: true,
      roleKey: true,
      isSuperAdmin: true,
      permissions: true,
      status: true,
      mustChangePassword: true,
      passwordSetAt: true,  // Add this field
    },
  });

  if (!admin || admin.status !== "ACTIVE") redirect("/login");

  // Force password change if the flag is set
  const h = await headers();
  const pathname = h.get("x-pathname") ?? "";
  if (admin.mustChangePassword && !pathname.includes("/settings/change-password")) {
    redirect("/settings/change-password");
  }

  // Force password change if password is older than 90 days
  const PASSWORD_EXPIRY_DAYS = 90;
  const passwordAge = admin.passwordSetAt
    ? (Date.now() - admin.passwordSetAt.getTime()) / (1000 * 60 * 60 * 24)
    : 0;

  if (passwordAge > PASSWORD_EXPIRY_DAYS && !pathname.includes("/settings/change-password")) {
    // Redirect to change-password page with a message
    // (Requires client-side state management)
    redirect("/settings/change-password?reason=expired");
  }

  return {
    id: admin.userId,
    email: admin.email,
    name: admin.name,
    roleKey: admin.roleKey,
    isSuperAdmin: admin.isSuperAdmin,
    permissions: permissionsForRole(admin.roleKey, admin.permissions),
  };
});
```

**Schema Update Required:**\
In `packages/database/prisma/schema.prisma`, add to `AdminUser` model:

```prisma
model AdminUser {
  // ... existing fields
  passwordSetAt       DateTime?   @default(now())
  // ... rest of fields
}
```

Run: `npx prisma db push`

