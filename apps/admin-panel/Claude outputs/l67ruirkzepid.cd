### Fix 9: Improve TOTP Migration Logic {#fix-9-improve-totp-migration-logic}

**File:** `src/lib/totp.ts` (lines 56\-67)

Replace `verifyTotpCode`\:

```typescript
export async function verifyTotpCode(
  encryptedOrPlainSecret: string,
  token: string,
): Promise<boolean> {
  if (!token || !/^\d{6}$/.test(token)) return false;

  let secret = encryptedOrPlainSecret;

  try {
    // Try to decrypt first (preferred)
    secret = decryptSecret(encryptedOrPlainSecret);
  } catch (err) {
    // If decryption fails, check if it's a valid base32 string (plaintext secret)
    // Valid TOTP secrets are base32-encoded (RFC 4648)
    const base32Regex = /^[A-Z2-7]+=*$/;
    
    if (!base32Regex.test(encryptedOrPlainSecret)) {
      console.warn("[TOTP] Invalid secret format: not base32 and decryption failed");
      return false;
    }

    // Assume it's plaintext base32
    secret = encryptedOrPlainSecret;
  }

  try {
    const result = await verify({ secret, token });
    return Boolean(result && (result as { valid?: boolean }).valid !== false);
  } catch (err) {
    console.error("[TOTP] Verification error:", err);
    return false;
  }
}
```

