## Fix 2: Add Middleware for API Route Protection {#fix-2-add-middleware-for-api-route-protection}

**File:** Create `src/middleware.ts` (new file)

```typescript
import { NextResponse } from "next/server";
import type { NextRequest } from "next/server";
import { readSession } from "@/lib/session";

/**
 * Middleware that protects all API routes by checking for valid sessions.
 * Public routes (login, logout) are explicitly allowed.
 */
export async function middleware(request: NextRequest) {
  const { pathname } = request.nextUrl;

  // Allow public routes
  const publicRoutes = [
    "/api/auth/login",
    "/api/auth/logout",
  ];

  if (publicRoutes.includes(pathname)) {
    return NextResponse.next();
  }

  // Protect all other API routes
  if (pathname.startsWith("/api")) {
    const session = await readSession();
    if (!session) {
      return NextResponse.json(
        { message: "Unauthorized" },
        { status: 401 }
      );
    }
  }

  return NextResponse.next();
}

export const config = {
  // Apply middleware to all routes except static assets and images
  matcher: [
    "/((?!_next/static|_next/image|favicon.ico|public).*)",
  ],
};
```

