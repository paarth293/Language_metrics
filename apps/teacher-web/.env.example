# =============================================================================
# Language Metrics — teacher-web environment
# Copy this file to apps/teacher-web/.env and fill in real values.
#
# NOTE: `next dev` / `next build` load .env ONLY from the app's own directory
# (apps/teacher-web). Vars defined in the repo-root .env are NOT visible here.
# If you run the root `npm run dev` / `npm run build` workspace scripts, make
# sure the app-local .env is complete — otherwise Google OAuth, JWT signing,
# and Redis sessions will fail at runtime.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/language_metrics"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/language_metrics"

# ── Authentication (RS256 JWT) ────────────────────────────────────────────────
# Same RSA keypair as the other apps/portals. Newlines as \n.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Legacy HS256 secret used by src/lib/auth.ts (signToken/verifyToken).
JWT_SECRET=""

# ── Redis (Session Store) ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (optional, transactional) ───────────────────────────────────────────
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Language Metrics <noreply@yourdomain.com>"
