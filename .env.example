# ── Live video (LiveKit) ──────────────────────────────────────────────────────
# Read ONLY by packages/livekit/src/config.ts. Nothing else in the monorepo
# should touch process.env.LIVEKIT_*.
#
# Get these from https://cloud.livekit.io -> your project -> Settings -> Keys.
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# wss:// for LiveKit Cloud. The HTTPS URL used for server-side REST calls is
# derived from this automatically — do not set it separately.
LIVEKIT_WS_URL="wss://your-project.livekit.cloud"

# ── Live class policy ─────────────────────────────────────────────────────────
# Every value here is a spending control. See docs/LIVEKIT.md.

# How early a participant may join. Longer = friendlier, and more billable
# minutes spent waiting in an empty room.
LIVEKIT_JOIN_WINDOW_MINUTES="10"
# How long after the scheduled end a class may keep running.
LIVEKIT_GRACE_MINUTES="10"
# Seconds before an empty room is torn down. LiveKit's default is 300; 120 is
# enough to survive a reconnect without leaving rooms lying around.
LIVEKIT_EMPTY_TIMEOUT_SECONDS="120"
# Seconds before a dropped participant is treated as gone.
LIVEKIT_DEPARTURE_TIMEOUT_SECONDS="20"
# Hard ceiling per class room. Bandwidth grows with the SQUARE of this number
# (n participants each receive n-1 streams), so raise it deliberately.
LIVEKIT_MAX_PARTICIPANTS="4"

# Default quality: audio-only | low | standard | high
# "low" is 360p @ 300kbps and is the right default for language tuition.
LIVEKIT_DEFAULT_QUALITY="low"

# Pricing tier used by the cost dashboard: build | ship | scale
LIVEKIT_PRICING_TIER="build"
# Monthly ceiling in USD. At 75% new classes drop to 360p, at 90% to audio
# only, and past 100% new rooms are refused (classes already running are never
# cut off). Set to a large number to disable the guard.
LIVEKIT_MONTHLY_BUDGET_USD="25"
# Plan allowances. Build tier: 5000 connection minutes and 50GB downstream.
LIVEKIT_INCLUDED_CONNECTION_MINUTES="5000"
LIVEKIT_INCLUDED_DOWNSTREAM_GB="50"

# ── Class recordings (LiveKit Egress) ─────────────────────────────────────────
# Optional. Leave blank to disable recording entirely.
# Recording bills $0.005/min for audio and $0.02/min for video, plus storage,
# so the platform defaults to audio.
LIVEKIT_RECORDING_BUCKET=""
LIVEKIT_RECORDING_ACCESS_KEY=""
LIVEKIT_RECORDING_SECRET_KEY=""
LIVEKIT_RECORDING_REGION="auto"
# Set for Supabase Storage or any other S3-compatible endpoint. Leave blank
# for real AWS S3.
LIVEKIT_RECORDING_ENDPOINT=""

# ── Cron ──────────────────────────────────────────────────────────────────────
# Shared secret for /api/cron/reconcile-sessions. Vercel Cron sends it as
# `Authorization: Bearer <secret>`. Without it the endpoint is public.
CRON_SECRET=""

# ── Storage (for profile photos, session materials, documents) ───────────────
# STORAGE_PROVIDER selects the backend: "s3" | "supabase" | "local" (default
# "local", which writes to apps/<app>/public/uploads — fine for dev only).
# STORAGE_PROVIDER="local"

# AWS S3 or compatible (e.g., Cloudflare R2, Backblaze B2) — used when
# STORAGE_PROVIDER="s3"
# STORAGE_BUCKET=""
# STORAGE_REGION=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# STORAGE_ENDPOINT=""           # Only needed for S3-compatible (non-AWS)
# STORAGE_PUBLIC_URL=""         # CDN / public bucket URL prefix, if any

# Supabase Storage — used when STORAGE_PROVIDER="supabase"
# SUPABASE_URL=""
# SUPABASE_SERVICE_KEY=""

# ── Zoho SMTP (OTP Emails) ───────────────────────────────────────────────────
# Used for sending OTP verification emails via Zoho Mail SMTP.
# The ZOHO_EMAIL account must have no-reply@languagemetrics.in as a verified alias.
ZOHO_EMAIL="no-reply@languagemetrics.in"
ZOHO_APP_PASSWORD=""
ZOHO_SMTP_HOST="smtp.zoho.in"
ZOHO_SMTP_PORT="465"

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Preferred way to create/rotate the first admin account — run:
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD="a-strong-unique-password" \
#     node --env-file=.env apps/admin-panel/scripts/create-admin.mjs
# These two vars are only needed for that one-off command, not at runtime.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""

# ── Student mobile app → student-web API (CORS) ──────────────────────────────
# apps/student-web/src/proxy.ts answers CORS preflights for /api/v1/* only.
# Expo web dev origins (http://localhost:8081, :19006) are allowed automatically
# when NODE_ENV !== "production". On Vercel, list any browser origins that should
# be able to call the deployed API (native iOS/Android builds don't need this):
#   MOBILE_WEB_ALLOWED_ORIGINS="http://localhost:8081,https://your-expo-web-preview.example.com"
MOBILE_WEB_ALLOWED_ORIGINS=""
