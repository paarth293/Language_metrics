# =============================================================================
# Language Metrics — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (e.g., from Supabase, Neon, Railway, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/language_metrics"
# Direct (non-pooled) connection, used by `prisma migrate`/`db push` against
# Supabase's connection pooler. Same as DATABASE_URL for a non-pooled DB.
# Also used at runtime by the reconcile crons' advisory lock (student-web),
# which falls back to DATABASE_URL when this is unset.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/language_metrics"

# ── Authentication (RS256 JWT) ────────────────────────────────────────────────
# Generate an RSA keypair for JWT signing:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
# Replace newlines with \n when adding to the .env file
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Admin-panel TOTP (2FA) secret encryption key (AES-256-GCM), used by
# apps/admin-panel/src/lib/totp.ts. Any random 32+ char string works — this
# is intentionally a SEPARATE secret from the JWT keys above. Required in
# production (admin-panel will not boot without it). There is no JWT_SECRET
# in this codebase; if an old .env still has one, it can be deleted.
#   openssl rand -hex 32
TOTP_ENCRYPTION_KEY=""

# ── Redis (Session Store + Rate Limiting) ────────────────────────────────────
# Redis connection URL for refresh tokens AND login rate limiting
# (e.g., Upstash, local Redis). Required in any deployed environment — the
# in-process fallback rate limiter does not protect a multi-instance/
# serverless deployment.
REDIS_URL="redis://localhost:6379"

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── App URLs ──────────────────────────────────────────────────────────────────
# The canonical public URL of the student/teacher app (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Base URL the browser-side code uses to call the API (usually the same host)
NEXT_PUBLIC_API_URL="http://localhost:3000"
# Admin panel's own canonical URL. NOTE (corrected, see docs/audits/error-log.md #N9): this
# is NOT currently read by the admin panel's login/CSRF check — that check
# (lib/security.ts#assertSameOrigin) compares the request's Origin header
# against its own Host header and needs no configured URL. ADMIN_PANEL_URL /
# APP_URL are kept here for other tooling/CORS use, but leaving them unset
# will NOT lock admins out of login.
ADMIN_PANEL_URL="http://localhost:3001"
# General app URL fallback (see note above — not read by the login origin check).
APP_URL="http://localhost:3000"

# ── Email (for OTP / Magic Links — see docs/design/frontend-specification.md §4.1) ────────
# Resend API key (https://resend.com)
# RESEND_API_KEY="re_..."

# SendGrid (alternative to Resend)
# SENDGRID_API_KEY="SG...."

# The from-address for transactional emails
# EMAIL_FROM="Language Metrics <noreply@yourdomain.com>"

# ─── Payments (Cashfree) ─────────────────────────────────────────────────────
# Cashfree Payment Gateway credentials for coin purchases and recording unlocks.
# The client secret also verifies webhooks; point the dashboard webhook at
# https://<student-web-host>/api/webhooks/cashfree. 1 coin = ₹1.
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""
# Required: "production" (live keys, real money) or "sandbox" (TEST... keys).
# Payments refuse to run if it is unset, misspelt, or "production" with a
# test-mode client id. Set it per environment in Vercel, never by committing .env.
CASHFREE_ENV="production"
# Optional: Slack/Discord-compatible webhook that receives payment incidents
# (unsettleable or duplicate payments, stuck orders, refunds, disputes).
# Unset = incidents are only logged with the [payment-incident] tag.
PAYMENT_ALERT_WEBHOOK_URL=""

# ── Live video (LiveKit) ──────────────────────────────────────────────────────
# Read ONLY by packages/livekit/src/config.ts. Nothing else in the monorepo
# should touch process.env.LIVEKIT_*.
#
# Get these from https://cloud.livekit.io -> your project -> Settings -> Keys.
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# wss:// for LiveKit Cloud. The HTTPS URL used for server-side REST calls is
# derived from this automatically — do not set it separately.
LIVEKIT_WS_URL=""
# Older name for the same setting, still accepted; LIVEKIT_WS_URL wins if both
# are set. Prefer LIVEKIT_WS_URL and leave this unset.
# LIVEKIT_URL=""

# ── Live class policy ─────────────────────────────────────────────────────────
# Every value here is a spending control. See docs/livekit.md.

# How early a participant may join. Longer = friendlier, and more billable
# minutes spent waiting in an empty room.
LIVEKIT_JOIN_WINDOW_MINUTES="10"
# How long after the scheduled end a class may keep running.
LIVEKIT_GRACE_MINUTES="10"
# Seconds before an empty room is torn down. LiveKit's default is 300; 120 is
# enough to survive a reconnect without leaving rooms lying around.
LIVEKIT_EMPTY_TIMEOUT_SECONDS="120"
# Seconds before a dropped participant is treated as gone.
LIVEKIT_DEPARTURE_TIMEOUT_SECONDS="20"
# Hard ceiling per class room. Bandwidth grows with the SQUARE of this number
# (n participants each receive n-1 streams), so raise it deliberately.
LIVEKIT_MAX_PARTICIPANTS="4"

# Default quality: audio-only | low | standard | high
# "low" is 360p @ 300kbps and is the right default for language tuition.
LIVEKIT_DEFAULT_QUALITY="low"

# Pricing tier used by the cost dashboard: build | ship | scale
LIVEKIT_PRICING_TIER="build"
# Monthly ceiling in USD. At 75% new classes drop to 360p, at 90% to audio
# only, and past 100% new rooms are refused (classes already running are never
# cut off). Set to a large number to disable the guard.
LIVEKIT_MONTHLY_BUDGET_USD="25"
# Plan allowances. Build tier: 5000 connection minutes and 50GB downstream.
LIVEKIT_INCLUDED_CONNECTION_MINUTES="5000"
LIVEKIT_INCLUDED_DOWNSTREAM_GB="50"

# ── Class recordings (LiveKit Egress) ─────────────────────────────────────────
# Optional. Leave blank to disable recording entirely.
# Recording bills $0.005/min for audio and $0.02/min for video, plus storage,
# so the platform defaults to audio.
LIVEKIT_RECORDING_BUCKET=""
LIVEKIT_RECORDING_ACCESS_KEY=""
LIVEKIT_RECORDING_SECRET_KEY=""
LIVEKIT_RECORDING_REGION="auto"
# Set for Supabase Storage or any other S3-compatible endpoint. Leave blank
# for real AWS S3.
LIVEKIT_RECORDING_ENDPOINT=""
# Older generic names, read only when the matching LIVEKIT_RECORDING_* above is
# unset (packages/livekit/src/server.ts). Prefer the LIVEKIT_RECORDING_* names.
# S3_BUCKET_NAME=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION=""
# S3_ENDPOINT=""

# ── Cron ──────────────────────────────────────────────────────────────────────
# Shared secret for /api/cron/reconcile-payments and /api/cron/reconcile-sessions
# on student-web (teacher-web answers 410). Vercel Cron and the GitHub
# workflows send it as `Authorization: Bearer <secret>`. Required on
# student-web in production; without it the endpoints refuse to run (500).
CRON_SECRET=""

# ── Storage (for profile photos, session materials, documents) ───────────────
# STORAGE_PROVIDER selects the backend: "s3" | "supabase" | "local" (default
# "local", which writes to apps/<app>/public/uploads — fine for dev only).
# STORAGE_PROVIDER="local"

# AWS S3 or compatible (e.g., Cloudflare R2, Backblaze B2) — used when
# STORAGE_PROVIDER="s3"
# STORAGE_BUCKET=""
# STORAGE_REGION=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# STORAGE_ENDPOINT=""           # Only needed for S3-compatible (non-AWS)
# STORAGE_PUBLIC_URL=""         # CDN / public bucket URL prefix, if any

# Supabase Storage — used when STORAGE_PROVIDER="supabase"
# SUPABASE_URL=""
# SUPABASE_SERVICE_KEY=""

# ── Zoho SMTP (OTP Emails) ───────────────────────────────────────────────────
# Used for sending OTP verification emails via Zoho Mail SMTP.
# The ZOHO_EMAIL account must have no-reply@languagemetrics.in as a verified alias.
ZOHO_EMAIL="no-reply@languagemetrics.in"
ZOHO_APP_PASSWORD=""
ZOHO_SMTP_HOST="smtp.zoho.in"
ZOHO_SMTP_PORT="465"

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Preferred way to create/rotate the first admin account — run:
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD="a-strong-unique-password" \
#     node --env-file=.env apps/admin-panel/scripts/create-admin.mjs
# These two vars are only needed for that one-off command, not at runtime.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""

# ── Student mobile app → student-web API (CORS) ──────────────────────────────
# apps/student-web/src/proxy.ts answers CORS preflights for /api/v1/* only.
# Expo web dev origins (http://localhost:8081, :19006) are allowed automatically
# when NODE_ENV !== "production". On Vercel, list any browser origins that should
# be able to call the deployed API (native iOS/Android builds don't need this):
#   MOBILE_WEB_ALLOWED_ORIGINS="http://localhost:8081,https://your-expo-web-preview.example.com"
MOBILE_WEB_ALLOWED_ORIGINS=""

# ── Other optional settings ──────────────────────────────────────────────────
# teacher-web /api/monitoring: bearer key for callers from other origins.
# Unset = only same-origin requests are answered.
# MONITORING_API_KEY=""
# teacher-web: where admins are sent after Google sign-in. Defaults to the
# production admin URL in production, http://localhost:3003 otherwise.
# NEXT_PUBLIC_ADMIN_URL="http://localhost:3003"
# teacher-web: absolute base for breadcrumb structured data (SEO). Unset = relative.
# NEXT_PUBLIC_BASE_URL="https://your-teacher-web-host"
# Web-push public VAPID key for the profile pages' notification opt-in.
# NEXT_PUBLIC_VAPID_KEY=""
# admin-panel: most coins one admin may adjust per day (default 50000).
# ADMIN_COIN_DAILY_LIMIT="50000"
# Time zone assumed for a teacher without one set (default Asia/Kolkata).
# DEFAULT_TEACHER_TIME_ZONE="Asia/Kolkata"

# ── Boot-time checks (src/env.ts in each web app) ────────────────────────────
# In production an app refuses to boot when a required variable is missing,
# a value has the wrong shape, or a feature is only partly configured (some
# CASHFREE_* / LIVEKIT_* / ZOHO_* / GOOGLE_* set but not all). Leaving a whole
# feature unset turns it off. In development the same problems are warnings.
#   All apps: DATABASE_URL, JWT_PRIVATE_KEY, JWT_PUBLIC_KEY, REDIS_URL
#   student-web also: CRON_SECRET    admin-panel also: TOTP_ENCRYPTION_KEY
