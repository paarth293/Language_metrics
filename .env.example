# =============================================================================
# Language Metrics — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (e.g., from Supabase, Neon, Railway, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/language_metrics"
# Direct (non-pooled) connection, used by `prisma migrate`/`db push` against
# Supabase's connection pooler. Same as DATABASE_URL for a non-pooled DB.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/language_metrics"

# ── Authentication (RS256 JWT) ────────────────────────────────────────────────
# Generate an RSA keypair for JWT signing:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
# Replace newlines with \n when adding to the .env file
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Admin-panel TOTP (2FA) secret encryption key (AES-256-GCM), used by
# apps/admin-panel/src/lib/totp.ts. Any random 32+ char string works — this
# is intentionally a SEPARATE secret from the JWT keys above (the code falls
# back to JWT_SECRET if this isn't set, but JWT_SECRET does not exist
# anywhere else in this codebase, so set this explicitly):
#   openssl rand -hex 32
TOTP_ENCRYPTION_KEY=""

# ── Redis (Session Store + Rate Limiting) ────────────────────────────────────
# Redis connection URL for refresh tokens AND login rate limiting
# (e.g., Upstash, local Redis). Required in any deployed environment — the
# in-process fallback rate limiter does not protect a multi-instance/
# serverless deployment.
REDIS_URL="redis://localhost:6379"

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── App URLs ──────────────────────────────────────────────────────────────────
# The canonical public URL of the student/teacher app (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Base URL the browser-side code uses to call the API (usually the same host)
NEXT_PUBLIC_API_URL="http://localhost:3000"
# Admin panel's own canonical URL. NOTE (corrected, see errors.md #N9): this
# is NOT currently read by the admin panel's login/CSRF check — that check
# (lib/security.ts#assertSameOrigin) compares the request's Origin header
# against its own Host header and needs no configured URL. ADMIN_PANEL_URL /
# APP_URL are kept here for other tooling/CORS use, but leaving them unset
# will NOT lock admins out of login.
ADMIN_PANEL_URL="http://localhost:3001"
# General app URL fallback (see note above — not read by the login origin check).
APP_URL="http://localhost:3000"

# ── Email (for OTP / Magic Links — see docs/internal/frontend.md §4.1) ────────
# Resend API key (https://resend.com)
# RESEND_API_KEY="re_..."

# SendGrid (alternative to Resend)
# SENDGRID_API_KEY="SG...."

# The from-address for transactional emails
# EMAIL_FROM="Language Metrics <noreply@yourdomain.com>"

# ─── Payments (Razorpay) ─────────────────────────────────────────────────────
# Razorpay API credentials for Coin purchasing and class payments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Live video (LiveKit) ──────────────────────────────────────────────────────
# Required by apps/teacher-web/src/lib/livekit.ts and apps/student-web's
# equivalent for issuing scoped room-join tokens. Get these from your
# LiveKit Cloud project (or a self-hosted LiveKit server).
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_WS_URL="wss://your-project.livekit.cloud"
# LIVEKIT_URL can be used as an alias for LIVEKIT_WS_URL
LIVEKIT_URL="wss://your-project.livekit.cloud"

# ── Storage (for profile photos, session materials, documents) ───────────────
# STORAGE_PROVIDER selects the backend: "s3" | "supabase" | "local" (default
# "local", which writes to apps/<app>/public/uploads — fine for dev only).
# STORAGE_PROVIDER="local"

# AWS S3 or compatible (e.g., Cloudflare R2, Backblaze B2) — used when
# STORAGE_PROVIDER="s3"
# STORAGE_BUCKET=""
# STORAGE_REGION=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# STORAGE_ENDPOINT=""           # Only needed for S3-compatible (non-AWS)
# STORAGE_PUBLIC_URL=""         # CDN / public bucket URL prefix, if any

# Supabase Storage — used when STORAGE_PROVIDER="supabase"
# SUPABASE_URL=""
# SUPABASE_SERVICE_KEY=""

# ── Zoho SMTP (OTP Emails) ───────────────────────────────────────────────────
# Used for sending OTP verification emails via Zoho Mail SMTP.
# The ZOHO_EMAIL account must have no-reply@languagemetrics.in as a verified alias.
ZOHO_EMAIL="no-reply@languagemetrics.in"
ZOHO_APP_PASSWORD=""
ZOHO_SMTP_HOST="smtp.zoho.in"
ZOHO_SMTP_PORT="465"

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Preferred way to create/rotate the first admin account — run:
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD="a-strong-unique-password" \
#     node --env-file=.env apps/admin-panel/scripts/create-admin.mjs
# These two vars are only needed for that one-off command, not at runtime.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
