# =============================================================================
# Language Metrics — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (e.g., from Supabase, Neon, Railway, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/language_metrics"
# Direct (non-pooled) connection, used by `prisma migrate`/`db push` against
# Supabase's connection pooler. Same as DATABASE_URL for a non-pooled DB.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/language_metrics"

# ── Authentication (RS256 JWT) ────────────────────────────────────────────────
# Generate an RSA keypair for JWT signing:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
# Replace newlines with \n when adding to the .env file
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Admin-panel TOTP (2FA) secret encryption key (AES-256-GCM), used by
# apps/admin-panel/src/lib/totp.ts. Any random 32+ char string works — this
# is intentionally a SEPARATE secret from the JWT keys above (the code falls
# back to JWT_SECRET if this isn't set, but JWT_SECRET does not exist
# anywhere else in this codebase, so set this explicitly):
#   openssl rand -hex 32
TOTP_ENCRYPTION_KEY=""

# ── Redis (Session Store + Rate Limiting) ────────────────────────────────────
# Redis connection URL for refresh tokens AND login rate limiting
# (e.g., Upstash, local Redis). Required in any deployed environment — the
# in-process fallback rate limiter does not protect a multi-instance/
# serverless deployment.
REDIS_URL="redis://localhost:6379"

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── App URLs ──────────────────────────────────────────────────────────────────
# The canonical public URL of the student/teacher app (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Base URL the browser-side code uses to call the API (usually the same host)
NEXT_PUBLIC_API_URL="http://localhost:3000"
# Admin panel's own canonical URL. NOTE (corrected, see errors.md #N9): this
# is NOT currently read by the admin panel's login/CSRF check — that check
# (lib/security.ts#assertSameOrigin) compares the request's Origin header
# against its own Host header and needs no configured URL. ADMIN_PANEL_URL /
# APP_URL are kept here for other tooling/CORS use, but leaving them unset
# will NOT lock admins out of login.
ADMIN_PANEL_URL="http://localhost:3001"
# General app URL fallback (see note above — not read by the login origin check).
APP_URL="http://localhost:3000"

# ── Email (for OTP / Magic Links — see docs/internal/frontend.md §4.1) ────────
# Resend API key (https://resend.com)
# RESEND_API_KEY="re_..."

# SendGrid (alternative to Resend)
# SENDGRID_API_KEY="SG...."

# The from-address for transactional emails
# EMAIL_FROM="Language Metrics <noreply@yourdomain.com>"

