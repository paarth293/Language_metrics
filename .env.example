# =============================================================================
# Language Metrics — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (e.g., from Supabase, Neon, Railway, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/language_metrics"

# ── Authentication (RS256 JWT) ────────────────────────────────────────────────
# Generate an RSA keypair for JWT signing:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
# Replace newlines with \n when adding to the .env file
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ── Redis (Session Store) ─────────────────────────────────────────────────────
# Redis connection URL for refresh tokens (e.g., Upstash, local Redis)
REDIS_URL="redis://localhost:6379"

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── App URL ───────────────────────────────────────────────────────────────────
# The canonical public URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (for OTP / Magic Links — see docs/internal/frontend.md §4.1) ────────
# Resend API key (https://resend.com)
# RESEND_API_KEY="re_..."

# SendGrid (alternative to Resend)
# SENDGRID_API_KEY="SG...."

# The from-address for transactional emails
# EMAIL_FROM="Language Metrics <noreply@yourdomain.com>"

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""

# ── Storage (for profile photos, session materials) ───────────────────────────
# AWS S3 or compatible (e.g., Cloudflare R2, Backblaze B2)
# STORAGE_BUCKET=""
# STORAGE_REGION=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# STORAGE_ENDPOINT=""           # Only needed for S3-compatible (non-AWS)
