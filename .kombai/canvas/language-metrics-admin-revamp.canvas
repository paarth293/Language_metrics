      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .admin-shell { font-family: 'Inter', sans-serif; }\n  .admin-mono { font-family: 'JetBrains Mono', monospace; }\n  .tabular-nums { font-variant-numeric: tabular-nums; }\n  .chart-wrap canvas { width: 100% !important; height: 210px !important; }\n</style>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js\">\n</script>\n<div class=\"admin-shell min-h-[1380px] bg-[#edf3f1] text-[#243439] flex antialiased\" data-kid=\"1\">\n    <!-- Primary module rail -->\n    <aside class=\"w-[82px] shrink-0 min-h-[1380px] bg-[#102d30] text-[#c9e1da] flex flex-col items-center px-3 py-5\" data-kid=\"1-1\">\n        <div class=\"flex items-center justify-center h-10 w-10 rounded-[13px] bg-[#f7fbf9] overflow-hidden shadow-[0_6px_18px_rgba(0,0,0,0.16)]\" data-kid=\"1-1-1\">\n            <img alt=\"Language Metrics logo\" class=\"h-9 w-9 object-cover\" data-kid=\"1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/apps/admin-panel/public/brand/logo-full.png\"/>\n        </div>\n        <div class=\"mt-8 flex w-full flex-col items-center gap-2\" data-kid=\"1-1-2\">\n            <div class=\"h-px w-8 bg-[#315456]\" data-kid=\"1-1-2-1\">\n            </div>\n            <div aria-current=\"page\" class=\"w-full rounded-[13px] bg-[#2a9d8f] px-1.5 py-2.5 text-center text-[#f5fffb] shadow-[0_8px_18px_rgba(42,157,143,0.18)]\" data-kid=\"1-1-2-2\">\n                <span class=\"mx-auto flex h-8 w-8 items-center justify-center text-[18px] text-[#f5fffb]\" data-kid=\"1-1-2-2-1\">\n                    <i class=\"ti ti-layout-dashboard\" data-kid=\"1-1-2-2-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                </span>\n                <span class=\"mt-1 block text-[9px] font-semibold tracking-[0.01em]\" data-kid=\"1-1-2-2-2\">\n                    Overview\n                </span>\n            </div>\n            <div class=\"w-full rounded-[13px] px-1.5 py-2.5 text-center hover:bg-[#183b3d]\" data-kid=\"1-1-2-3\">\n                <span class=\"mx-auto flex h-8 w-8 items-center justify-center text-[18px] text-[#9fc5bd]\" data-kid=\"1-1-2-3-1\">\n                    <i class=\"ti ti-users\" data-kid=\"1-1-2-3-1-1\">\n                    </i>\n                </span>\n                <span class=\"mt-1 block text-[9px] font-medium\" data-kid=\"1-1-2-3-2\">\n                    People\n                </span>\n            </div>\n            <div class=\"w-full rounded-[13px] px-1.5 py-2.5 text-center hover:bg-[#183b3d]\" data-kid=\"1-1-2-4\">\n                <span class=\"mx-auto flex h-8 w-8 items-center justify-center text-[18px] text-[#9fc5bd]\" data-kid=\"1-1-2-4-1\">\n                    <i class=\"ti ti-book-2\" data-kid=\"1-1-2-4-1-1\">\n                    </i>\n                </span>\n                <span class=\"mt-1 block text-[9px] font-medium\" data-kid=\"1-1-2-4-2\">\n                    Learning\n                </span>\n            </div>\n            <div class=\"w-full rounded-[13px] px-1.5 py-2.5 text-center hover:bg-[#183b3d]\" data-kid=\"1-1-2-5\">\n                <span class=\"mx-auto flex h-8 w-8 items-center justify-center text-[18px] text-[#9fc5bd]\" data-kid=\"1-1-2-5-1\">\n                    <i class=\"ti ti-wallet\" data-kid=\"1-1-2-5-1-1\">\n                    </i>\n                </span>\n                <span class=\"mt-1 block text-[9px] font-medium\" data-kid=\"1-1-2-5-2\">\n                    Finance\n                </span>\n            </div>\n            <div class=\"w-full rounded-[13px] px-1.5 py-2.5 text-center hover:bg-[#183b3d]\" data-kid=\"1-1-2-6\">\n                <span class=\"mx-auto flex h-8 w-8 items-center justify-center text-[18px] text-[#9fc5bd]\" data-kid=\"1-1-2-6-1\">\n                    <i class=\"ti ti-activity\" data-kid=\"1-1-2-6-1-1\">\n                    </i>\n                </span>\n                <span class=\"mt-1 block text-[9px] font-medium\" data-kid=\"1-1-2-6-2\">\n                    Operations\n                </span>\n            </div>\n            <div class=\"w-full rounded-[13px] px-1.5 py-2.5 text-center hover:bg-[#183b3d]\" data-kid=\"1-1-2-7\">\n                <span class=\"mx-auto flex h-8 w-8 items-center justify-center text-[18px] text-[#9fc5bd]\" data-kid=\"1-1-2-7-1\">\n                    <i class=\"ti ti-shield-lock\" data-kid=\"1-1-2-7-1-1\">\n                    </i>\n                </span>\n                <span class=\"mt-1 block text-[9px] font-medium\" data-kid=\"1-1-2-7-2\">\n                    System\n                </span>\n            </div>\n        </div>\n        <div class=\"mt-auto flex w-full flex-col items-center gap-2\" data-kid=\"1-1-3\">\n            <div class=\"h-px w-8 bg-[#315456]\" data-kid=\"1-1-3-1\">\n            </div>\n            <div class=\"flex h-9 w-9 items-center justify-center rounded-full border border-[#4a7470] bg-[#193f40] text-[12px] font-semibold text-[#cce8df]\" data-kid=\"1-1-3-2\">\n                SA\n            </div>\n            <span class=\"flex h-8 w-8 items-center justify-center rounded-[10px] text-[17px] text-[#9fc5bd]\" data-kid=\"1-1-3-3\">\n                <i class=\"ti ti-settings\" data-kid=\"1-1-3-3-1\">\n                </i>\n            </span>\n        </div>\n    </aside>\n    <!-- Contextual navigation -->\n    <aside class=\"w-[230px] shrink-0 min-h-[1380px] border-r border-[#dce7e2] bg-[#f7fbf9] flex flex-col\" data-kid=\"1-2\">\n        <div class=\"border-b border-[#dce7e2] px-6 py-5\" data-kid=\"1-2-1\">\n            <p class=\"text-[14px] font-bold tracking-[-0.02em] text-[#193c3d]\" data-kid=\"1-2-1-1\">\n                Language Metrics\n            </p>\n            <div class=\"mt-1 flex items-center gap-2\" data-kid=\"1-2-1-2\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[#2a9d8f]\" data-kid=\"1-2-1-2-1\">\n                </span>\n                <p class=\"text-[11px] font-medium text-[#79908e]\" data-kid=\"1-2-1-2-2\">\n                    Admin Portal\n                </p>\n            </div>\n        </div>\n        <div class=\"px-5 pt-6\" data-kid=\"1-2-2\">\n            <p class=\"text-[10px] font-semibold uppercase tracking-[0.13em] text-[#8ca19e]\" data-kid=\"1-2-2-1\">\n                Overview\n            </p>\n            <div class=\"mt-3 rounded-[12px] border border-[#dbe7e2] bg-white p-1 shadow-[0_5px_16px_rgba(33,65,62,0.035)]\" data-kid=\"1-2-2-2\">\n                <div class=\"flex items-center gap-2.5 rounded-[9px] bg-[#e8f4f0] px-3 py-2.5 text-[12px] font-semibold text-[#1d6d69]\" data-kid=\"1-2-2-2-1\">\n                    <span class=\"flex text-[15px] text-[#2a9d8f]\" data-kid=\"1-2-2-2-1-1\">\n                        <i class=\"ti ti-layout-dashboard\" data-kid=\"1-2-2-2-1-1-1\">\n                        </i>\n                    </span>\n                    Dashboard\n                    <span class=\"ml-auto flex text-[14px] text-[#78aaa2]\" data-kid=\"1-2-2-2-1-2\">\n                        <i class=\"ti ti-chevron-down\" data-kid=\"1-2-2-2-1-2-1\">\n                        </i>\n                    </span>\n                </div>\n                <div class=\"ml-7 mt-1 space-y-0.5 border-l border-[#cfe4de] pb-1 pl-3\" data-kid=\"1-2-2-2-2\">\n                    <div class=\"rounded-md bg-[#f3faf7] px-2.5 py-2 text-[11px] font-semibold text-[#267d75]\" data-kid=\"1-2-2-2-2-1\">\n                        Executive overview\n                    </div>\n                    <div class=\"px-2.5 py-2 text-[11px] font-medium text-[#829693]\" data-kid=\"1-2-2-2-2-2\">\n                        Daily brief\n                    </div>\n                    <div class=\"px-2.5 py-2 text-[11px] font-medium text-[#829693]\" data-kid=\"1-2-2-2-2-3\">\n                        Reports\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"mt-7 px-5\" data-kid=\"1-2-3\">\n            <p class=\"text-[10px] font-semibold uppercase tracking-[0.13em] text-[#8ca19e]\" data-kid=\"1-2-3-1\">\n                Workspace\n            </p>\n            <div class=\"mt-3 space-y-1\" data-kid=\"1-2-3-2\">\n                <div class=\"flex items-center justify-between rounded-[10px] px-3 py-2.5 text-[12px] font-medium text-[#607673]\" data-kid=\"1-2-3-2-1\">\n                    <span class=\"flex items-center gap-2.5\" data-kid=\"1-2-3-2-1-1\">\n                        <span class=\"flex text-[15px] text-[#8ba29e]\" data-kid=\"1-2-3-2-1-1-1\">\n                            <i class=\"ti ti-users\" data-kid=\"1-2-3-2-1-1-1-1\">\n                            </i>\n                        </span>\n                        People\n                    </span>\n                    <span class=\"text-[11px] text-[#a8b9b5]\" data-kid=\"1-2-3-2-1-2\">\n                        ⌘ 1\n                    </span>\n                </div>\n                <div class=\"flex items-center justify-between rounded-[10px] px-3 py-2.5 text-[12px] font-medium text-[#607673]\" data-kid=\"1-2-3-2-2\">\n                    <span class=\"flex items-center gap-2.5\" data-kid=\"1-2-3-2-2-1\">\n                        <span class=\"flex text-[15px] text-[#8ba29e]\" data-kid=\"1-2-3-2-2-1-1\">\n                            <i class=\"ti ti-book\" data-kid=\"1-2-3-2-2-1-1-1\">\n                            </i>\n                        </span>\n                        Learning\n                    </span>\n                    <span class=\"text-[11px] text-[#a8b9b5]\" data-kid=\"1-2-3-2-2-2\">\n                        ⌘ 2\n                    </span>\n                </div>\n                <div class=\"flex items-center justify-between rounded-[10px] px-3 py-2.5 text-[12px] font-medium text-[#607673]\" data-kid=\"1-2-3-2-3\">\n                    <span class=\"flex items-center gap-2.5\" data-kid=\"1-2-3-2-3-1\">\n                        <span class=\"flex text-[15px] text-[#8ba29e]\" data-kid=\"1-2-3-2-3-1-1\">\n                            <i class=\"ti ti-wallet\" data-kid=\"1-2-3-2-3-1-1-1\">\n                            </i>\n                        </span>\n                        Finance\n                    </span>\n                    <span class=\"text-[11px] text-[#a8b9b5]\" data-kid=\"1-2-3-2-3-2\">\n                        ⌘ 3\n                    </span>\n                </div>\n                <div class=\"flex items-center justify-between rounded-[10px] px-3 py-2.5 text-[12px] font-medium text-[#607673]\" data-kid=\"1-2-3-2-4\">\n                    <span class=\"flex items-center gap-2.5\" data-kid=\"1-2-3-2-4-1\">\n                        <span class=\"flex text-[15px] text-[#8ba29e]\" data-kid=\"1-2-3-2-4-1-1\">\n                            <i class=\"ti ti-message-circle\" data-kid=\"1-2-3-2-4-1-1-1\">\n                            </i>\n                        </span>\n                        Moderation\n                    </span>\n                    <span class=\"rounded-full bg-[#fff3da] px-2 py-0.5 text-[10px] font-semibold text-[#ab7a20]\" data-kid=\"1-2-3-2-4-2\">\n                        4\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"mt-auto px-5 pb-6\" data-kid=\"1-2-4\">\n            <div class=\"rounded-[14px] border border-[#dbe7e2] bg-white p-4\" data-kid=\"1-2-4-1\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-4-1-1\">\n                    <span class=\"flex text-[15px] text-[#2a9d8f]\" data-kid=\"1-2-4-1-1-1\">\n                        <i class=\"ti ti-world\" data-kid=\"1-2-4-1-1-1-1\">\n                        </i>\n                    </span>\n                    <span class=\"text-[11px] font-semibold text-[#415b59]\" data-kid=\"1-2-4-1-1-2\">\n                        Live workspace\n                    </span>\n                </div>\n                <p class=\"mt-2 text-[11px] leading-5 text-[#829693]\" data-kid=\"1-2-4-1-2\">\n                    South Asia · production data\n                </p>\n                <div class=\"mt-3 h-1.5 overflow-hidden rounded-full bg-[#e6efeb]\" data-kid=\"1-2-4-1-3\">\n                    <div class=\"h-full w-[76%] rounded-full bg-[#7ac8b7]\" data-kid=\"1-2-4-1-3-1\">\n                    </div>\n                </div>\n                <p class=\"mt-2 text-[10px] font-medium text-[#8ca19e]\" data-kid=\"1-2-4-1-4\">\n                    76% of daily capacity\n                </p>\n            </div>\n        </div>\n    </aside>\n    <!-- Main work area -->\n    <main class=\"min-w-0 flex-1 bg-[#edf3f1]\" data-kid=\"1-3\">\n        <header class=\"flex h-[74px] items-center justify-between border-b border-[#dce7e2] bg-[#f7fbf9] px-8\" data-kid=\"1-3-1\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-3-1-1\">\n                <div class=\"flex h-10 w-[430px] items-center gap-3 rounded-[12px] border border-[#dce7e2] bg-white px-3.5 text-[#91a5a1] shadow-[0_4px_12px_rgba(33,65,62,0.025)]\" data-kid=\"1-3-1-1-1\">\n                    <span class=\"flex text-[18px] text-[#78908c]\" data-kid=\"1-3-1-1-1-1\">\n                        <i class=\"ti ti-search\" data-kid=\"1-3-1-1-1-1-1\">\n                        </i>\n                    </span>\n                    <span class=\"text-[12px] font-medium\" data-kid=\"1-3-1-1-1-2\">\n                        Search people, classes, payouts…\n                    </span>\n                    <span class=\"ml-auto rounded-[6px] border border-[#dce7e2] bg-[#f6faf8] px-1.5 py-0.5 text-[10px] font-semibold text-[#8da39f]\" data-kid=\"1-3-1-1-1-3\">\n                        ⌘ K\n                    </span>\n                </div>\n                <div class=\"hidden items-center gap-2 text-[11px] font-medium text-[#829693] xl:flex\" data-kid=\"1-3-1-1-2\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#44bca2]\" data-kid=\"1-3-1-1-2-1\">\n                    </span>\n                    Secure session · activity logging on\n                </div>\n            </div>\n            <div class=\"flex items-center gap-5\" data-kid=\"1-3-1-2\">\n                <div class=\"flex items-center gap-2 text-[11px] font-medium text-[#829693]\" data-kid=\"1-3-1-2-1\">\n                    <span class=\"flex text-[15px] text-[#2a9d8f]\" data-kid=\"1-3-1-2-1-1\">\n                        <i class=\"ti ti-clock\" data-kid=\"1-3-1-2-1-1-1\" data-name=\"last updated icon\">\n                        </i>\n                    </span>\n                    Updated 2m ago\n                </div>\n                <div class=\"relative flex h-9 w-9 items-center justify-center rounded-[10px] border border-[#dce7e2] bg-white text-[18px] text-[#5e7773]\" data-kid=\"1-3-1-2-2\">\n                    <i class=\"ti ti-bell\" data-kid=\"1-3-1-2-2-1\">\n                    </i>\n                    <span class=\"absolute right-1.5 top-1.5 h-1.5 w-1.5 rounded-full bg-[#e6a43a] ring-2 ring-white\" data-kid=\"1-3-1-2-2-2\">\n                    </span>\n                </div>\n                <div class=\"flex h-9 w-9 items-center justify-center rounded-[10px] border border-[#dce7e2] bg-white text-[18px] text-[#5e7773]\" data-kid=\"1-3-1-2-3\">\n                    <i class=\"ti ti-moon\" data-kid=\"1-3-1-2-3-1\">\n                    </i>\n                </div>\n                <div class=\"flex items-center gap-2.5 border-l border-[#dce7e2] pl-5\" data-kid=\"1-3-1-2-4\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#d7eee7] text-[12px] font-bold text-[#246c68]\" data-kid=\"1-3-1-2-4-1\">\n                        SA\n                    </div>\n                    <div class=\"leading-tight\" data-kid=\"1-3-1-2-4-2\">\n                        <p class=\"text-[12px] font-semibold text-[#2a403f]\" data-kid=\"1-3-1-2-4-2-1\">\n                            Super Admin\n                        </p>\n                        <p class=\"mt-0.5 text-[10px] font-medium text-[#8aa09b]\" data-kid=\"1-3-1-2-4-2-2\">\n                            admin@gmail.com\n                        </p>\n                    </div>\n                    <span class=\"flex text-[15px] text-[#8da39f]\" data-kid=\"1-3-1-2-4-3\">\n                        <i class=\"ti ti-chevron-down\" data-kid=\"1-3-1-2-4-3-1\">\n                        </i>\n                    </span>\n                </div>\n            </div>\n        </header>\n        <div class=\"mx-auto max-w-[1240px] px-8 pb-14 pt-8\" data-kid=\"1-3-2\">\n            <div class=\"flex items-end justify-between gap-6\" data-kid=\"1-3-2-1\">\n                <div data-kid=\"1-3-2-1-1\">\n                    <div class=\"flex items-center gap-2 text-[11px] font-semibold text-[#829693]\" data-kid=\"1-3-2-1-1-1\">\n                        <span data-kid=\"1-3-2-1-1-1-1\">\n                            Tuesday, 20 August 2026\n                        </span>\n                        <span class=\"h-1 w-1 rounded-full bg-[#a5b7b2]\" data-kid=\"1-3-2-1-1-1-2\">\n                        </span>\n                        <span data-kid=\"1-3-2-1-1-1-3\">\n                            IST · Live data\n                        </span>\n                    </div>\n                    <h1 class=\"mt-2 text-[30px] font-bold tracking-[-0.035em] text-[#193c3d]\" data-kid=\"1-3-2-1-1-2\">\n                        Executive Overview\n                    </h1>\n                    <p class=\"mt-2 text-[13px] font-medium text-[#708783]\" data-kid=\"1-3-2-1-1-3\">\n                        A clear view of platform health, operator queues, and the work that needs attention today.\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-3-2-1-2\">\