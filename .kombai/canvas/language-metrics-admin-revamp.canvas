      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n.ops-mono { font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace; }\n.ops-number { font-variant-numeric: tabular-nums; }\n.ops-scroll::-webkit-scrollbar { width: 6px; height: 6px; }\n.ops-scroll::-webkit-scrollbar-thumb { background: rgba(37, 72, 75, .18); border-radius: 999px; }\n.ops-chart-wrap { position: relative; height: 238px; }\n.ops-dot-grid { background-image: radial-gradient(rgba(38, 95, 93, .12) 1px, transparent 1px); background-size: 18px 18px; }\n</style>\n<div class=\"min-h-screen w-full bg-[#edf3f1] text-[#20383a] antialiased flex font-sans\" data-kid=\"1\">\n    <!-- Primary module rail -->\n    <aside class=\"w-[218px] shrink-0 min-h-screen bg-[#142b2e] text-[#d8e8e4] flex flex-col border-r border-[#29484a]\" data-kid=\"1-1\">\n        <div class=\"h-[86px] px-5 flex items-center gap-3 border-b border-[#29484a]\" data-kid=\"1-1-1\">\n            <div class=\"w-10 h-10 rounded-[13px] bg-[#f5f7f3] flex items-center justify-center overflow-hidden shadow-[0_6px_18px_rgba(0,0,0,.18)]\" data-kid=\"1-1-1-1\">\n                <img alt=\"Language Metrics logo\" class=\"w-full h-full object-cover\" data-kid=\"1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/apps/admin-panel/public/brand/logo-full.png\"/>\n            </div>\n            <div class=\"min-w-0\" data-kid=\"1-1-1-2\">\n                <p class=\"text-[13px] font-semibold tracking-[-.01em] text-white truncate\" data-kid=\"1-1-1-2-1\">\n                    Language Metrics\n                </p>\n                <p class=\"text-[10px] uppercase tracking-[.18em] text-[#86a7a5] mt-1\" data-kid=\"1-1-1-2-2\">\n                    Admin Portal\n                </p>\n            </div>\n        </div>\n        <div class=\"px-4 pt-6 pb-2 flex items-center justify-between\" data-kid=\"1-1-2\">\n            <p class=\"text-[10px] uppercase tracking-[.18em] text-[#769494] font-semibold\" data-kid=\"1-1-2-1\">\n                Workspace\n            </p>\n            <span class=\"text-[10px] text-[#79c9bf] ops-mono\" data-kid=\"1-1-2-2\">\n                v2.4\n            </span>\n        </div>\n        <nav aria-label=\"Primary modules\" class=\"px-3 space-y-1\" data-kid=\"1-1-3\">\n            <a class=\"flex items-center gap-3 rounded-[11px] px-3 py-3 bg-[#234447] text-white border border-[#356361] shadow-[inset_3px_0_0_#79c9bf]\" data-kid=\"1-1-3-1\" href=\"#\">\n                <span aria-hidden=\"true\" class=\"text-[17px] text-[#79c9bf] leading-none\" data-kid=\"1-1-3-1-1\">\n                    <i class=\"ti ti-layout-dashboard\" data-kid=\"1-1-3-1-1-1\">\n                    </i>\n                </span>\n                <span class=\"text-[12px] font-semibold\" data-kid=\"1-1-3-1-2\">\n                    Overview\n                </span>\n                <span class=\"ml-auto text-[10px] ops-mono text-[#a8cfca]\" data-kid=\"1-1-3-1-3\">\n                    01\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 rounded-[11px] px-3 py-3 text-[#9bb5b2] hover:bg-[#1c393c]\" data-kid=\"1-1-3-2\" href=\"#\">\n                <span aria-hidden=\"true\" class=\"text-[17px] text-[#8caeaa] leading-none\" data-kid=\"1-1-3-2-1\">\n                    <i class=\"ti ti-users\" data-kid=\"1-1-3-2-1-1\">\n                    </i>\n                </span>\n                <span class=\"text-[12px] font-medium\" data-kid=\"1-1-3-2-2\">\n                    People\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 rounded-[11px] px-3 py-3 text-[#9bb5b2] hover:bg-[#1c393c]\" data-kid=\"1-1-3-3\" href=\"#\">\n                <span aria-hidden=\"true\" class=\"text-[17px] text-[#8caeaa] leading-n