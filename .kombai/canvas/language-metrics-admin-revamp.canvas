                                  <p class=\"mt-0.5 text-[10px]\" data-kid=\"1-1-3-2-6-3-3-1-2-2\" style=\"color:#9ba9ac;\">\n                                        nikita.s@example.com\n                                    </p>\n                                </div>\n                            </div>\n                            <span class=\"text-[11px]\" data-kid=\"1-1-3-2-6-3-3-2\" style=\"color:#60777c;\">\n                                16 Aug 2026\n                            </span>\n                            <span class=\"text-[11px]\" data-kid=\"1-1-3-2-6-3-3-3\" style=\"color:#60777c;\">\n                                Hindi · Beginners\n                            </span>\n                            <span class=\"flex items-center gap-2\" data-kid=\"1-1-3-2-6-3-3-4\">\n                                <span class=\"h-2 w-2 rounded-full\" data-kid=\"1-1-3-2-6-3-3-4-1\" style=\"background:#c46d67;\">\n                                </span>\n                                <span class=\"rounded-full px-2 py-1 text-[10px] font-semibold\" data-kid=\"1-1-3-2-6-3-3-4-2\" style=\"background:var(--red-soft); color:#a85e5a;\">\n                                    Needs info\n                                </span>\n                            </span>\n                            <span class=\"text-right text-[11px] font-semibold\" data-kid=\"1-1-3-2-6-3-3-5\" style=\"color:#2f988b;\">\n                                Review\n                                <span class=\"icon-frame text-[12px] align-middle\" data-kid=\"1-1-3-2-6-3-3-5-1\" style=\"color:#2f988b; width:13px; height:13px;\">\n                                    <i class=\"ti ti-arrow-up-right\" data-kid=\"1-1-3-2-6-3-3-5-1-1\">\n                                    </i>\n                                </span>\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center justify-between border-t px-6 py-3.5\" data-kid=\"1-1-3-2-6-4\" style=\"background:#fbfcfc; border-color:#edf1f0;\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-1-3-2-6-4-1\">\n                            <span class=\"icon-frame text-[14px]\" data-kid=\"1-1-3-2-6-4-1-1\" style=\"color:#9bb0b1; width:15px; height:15px;\">\n                                <i class=\"ti ti-inbox\" data-kid=\"1-1-3-2-6-4-1-1-1\">\n                                </i>\n                            </span>\n                            <span class=\"text-[11px]\" data-kid=\"1-1-3-2-6-4-1-2\" style=\"color:#899b9e;\">\n                                No more approvals in this window.\n                            </span>\n                            <span class=\"text-[11px]\" data-kid=\"1-1-3-2-6-4-1-3\" data-name=\"automatic status message\" style=\"color:#a8b4b6;\">\n                                New applications will appear automatically.\n                            </span>\n                        </div>\n                        <span class=\"font-mono-lm text-[10px]\" data-kid=\"1-1-3-2-6-4-2\" data-name=\"row count label\" style=\"color:#9aabb0;\">\n                            Showing 3 of 12\n                        </span>\n                    </div>\n                </section>\n                <div class=\"mt-6 flex items-center justify-between text-[10px]\" data-kid=\"1-1-3-2-7\" style=\"color:#a0afb1;\">\n                    <span data-kid=\"1-1-3-2-7-1\">\n                        Language Metrics Admin Portal · Internal operations workspace\n                    </span>\n                    <span class=\"flex items-center gap-2\" data-kid=\"1-1-3-2-7-2\">\n                        <span class=\"h-1.5 w-1.5 rounded-full\" data-kid=\"1-1-3-2-7-2-1\" style=\"background:#2f988b;\">\n                        </span>\n                        Data refreshed moments ago\n                    </span>\n                </div>\n            </div>\n        </main>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js\">\n</script>\n<script>\n    const chartCanvas = document.getElementById('revenueChart');\n  if (chartCanvas && window.Chart) {\n    const context = chartCanvas.getContext('2d');\n    const fill = context.createLinearGradient(0, 0, 0, 250);\n    fill.addColorStop(0, 'rgba(47,152,139,0.18)');\n    fill.addColorStop(1, 'rgba(47,152,139,0)');\n    new Chart(chartCanvas, {\n      type: 'line',\n      data: {\n        labels: ['01 Aug','03 Aug','05 Aug','07 Aug','09 Aug','11 Aug','13 Aug','15 Aug','17 Aug','20 Aug'],\n        datasets: [\n          { label: 'Current period', data: [24,31,28,42,39,47,54,51,68,77], borderColor: '#2f988b', backgroundColor: fill, fill: true, borderWidth: 2.5, pointRadius: 0, pointHoverRadius: 4, tension: 0.38 },\n          { label: 'Previous period', data: [21,25,27,29,34,35,38,44,48,53], borderColor: '#b8c9c8', borderWidth: 1.5, borderDash: [5,5], pointRadius: 0, tension: 0.38 }\n        ]\n      },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        interaction: { intersect: false, mode: 'index' },\n        plugins: { legend: { display: false }, tooltip: { backgroundColor: '#1d303b', titleFont: { family: 'Inter', size: 11 }, bodyFont: { family: 'JetBrains Mono', size: 10 }, displayColors: false, padding: 10, cornerRadius: 8 } },\n        scales: {\n          x: { grid: { display: false }, border: { display: false }, ticks: { color: '#9aabb0', font: { family: 'Inter', size: 10 }, maxTicksLimit: 5 } },\n          y: { beginAtZero: true, border: { display: false }, grid: { color: '#edf2f1' }, ticks: { color: '#a0afb1', font: { family: 'JetBrains Mono', size: 10 }, callback: (value) => '₹' + value + 'k', maxTicksLimit: 5 } }\n        }\n      }\n    });\n  }\n</script>\n",
