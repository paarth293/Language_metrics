-5-2-1-1\">\n                            <p class=\"text-[10px] font-semibold uppercase tracking-[0.13em] text-[#8ca19e]\" data-kid=\"1-3-2-5-2-1-1-1\">\n                                Filtered state\n                            </p>\n                            <h2 class=\"mt-2 text-[15px] font-bold tracking-[-0.02em] text-[#244241]\" data-kid=\"1-3-2-5-2-1-1-2\">\n                                Suspended / rejected\n                            </h2>\n                        </div>\n                        <span class=\"flex h-9 w-9 items-center justify-center rounded-[10px] bg-white text-[18px] text-[#8da39f]\" data-kid=\"1-3-2-5-2-1-2\">\n                            <i class=\"ti ti-archive-off\" data-kid=\"1-3-2-5-2-1-2-1\">\n                            </i>\n                        </span>\n                    </div>\n                    <div class=\"mt-9 flex flex-col items-center text-center\" data-kid=\"1-3-2-5-2-2\">\n                        <div class=\"flex h-14 w-14 items-center justify-center rounded-full border border-dashed border-[#b8d8d0] bg-white text-[24px] text-[#69aa9f]\" data-kid=\"1-3-2-5-2-2-1\">\n                            <i class=\"ti ti-users-off\" data-kid=\"1-3-2-5-2-2-1-1\">\n                            </i>\n                        </div>\n                        <p class=\"mt-4 text-[12px] font-semibold text-[#46635e]\" data-kid=\"1-3-2-5-2-2-2\">\n                            No profiles in this view\n                        </p>\n                        <p class=\"mt-2 max-w-[220px] text-[10px] leading-5 text-[#8aa09b]\" data-kid=\"1-3-2-5-2-2-3\">\n                            There are no suspended teachers right now. Clear the filter to return to the full directory.\n                        </p>\n                        <div class=\"mt-5 flex h-8 items-center gap-2 rounded-[8px] bg-[#1b5553] px-3 text-[10px] font-semibold text-white\" data-kid=\"1-3-2-5-2-2-4\">\n                            <span class=\"flex text-[13px] text-[#bfece0]\" data-kid=\"1-3-2-5-2-2-4-1\">\n                                <i class=\"ti ti-refresh\" data-kid=\"1-3-2-5-2-2-4-1-1\">\n                                </i>\n                            </span>\n                            Clear filter\n                        </div>\n                    </div>\n                    <div class=\"mt-9 rounded-[10px] border border-[#dcebe5] bg-white px-3 py-2.5 text-[10px] font-medium text-[#829693]\" data-dynamic=\"true\" data-kid=\"1-3-2-5-2-3\" data-name=\"refresh indicator\" data-reason=\"text and color indicate live refresh status\">\n                        <span class=\"mr-1.5 inline-flex h-1.5 w-1.5 rounded-full bg-[#2a9d8f]\" data-kid=\"1-3-2-5-2-3-1\">\n                        </span>\n                        Live table · refreshes every 30 sec\n                    </div>\n                </div>\n            </section>\n        </div>\n    </main>\n</div>\n<script>\n    const pulseCanvas = document.getElementById('platformPulse');\n  if (pulseCanvas && window.Chart) {\n    new Chart(pulseCanvas, {\n      type: 'line',\n      data: {\n        labels: ['01 Aug', '05', '09', '13', '17', '21', '25', '30'],\n        datasets: [\n          { label: 'Revenue', data: [28, 36, 32, 48, 43, 55, 62, 72], borderColor: '#2a9d8f', backgroundColor: 'rgba(42,157,143,0.10)', fill: true, borderWidth: 2.5, pointRadius: 0, tension: 0.42 },\n          { label: 'Previous period', data: [26, 29, 34, 37, 41, 45, 50, 57], borderColor: '#c8ddd7', backgroundColor: 'transparent', fill: false, borderWidth: 2, borderDash: [5, 5], pointRadius: 0, tension: 0.42 }\n        ]\n      },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        plugins: { legend: { display: false }, tooltip: { backgroundColor: '#193f40', padding: 10, titleFont: { family: 'Inter', size: 11 }, bodyFont: { family: 'JetBrains Mono', size: 11 }, displayColors: false } },\n        scales: { x: { grid: { display: false }, border: { display: false }, ticks: { color: '#9aada9', font: { family: 'Inter', size: 10 } } }, y: { beginAtZero: true, grid: { color: '#edf2f0' }, border: { display: false }, ticks: { color: '#9aada9', font: { family: 'JetBrains Mono', size: 10 }, callback: (value) => '₹' + value + 'k' } } }\n      }\n    });\n  }\n</script>\n",
