data-kid=\"1-1-3-2-6-3-1-5-1-1\">\n                                    </i>\n                                </span>\n                            </span>\n                        </div>\n                        <div class=\"grid grid-cols-[1.3fr_1fr_0.8fr_0.85fr_0.7fr] items-center px-6 py-4\" data-kid=\"1-1-3-2-6-3-2\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"1-1-3-2-6-3-2-1\">\n                                <div class=\"icon-frame h-8 w-8 rounded-full\" data-kid=\"1-1-3-2-6-3-2-1-1\" style=\"background:#e6ecf0; color:#59727a;\">\n                                    <span class=\"text-[11px] font-semibold\" data-kid=\"1-1-3-2-6-3-2-1-1-1\" style=\"color:#59727a;\">\n                                        SI\n                                    </span>\n                                </div>\n                                <div data-kid=\"1-1-3-2-6-3-2-1-2\">\n                                    <p class=\"text-[12px] font-semibold\" data-kid=\"1-1-3-2-6-3-2-1-2-1\" style=\"color:#40555a;\">\n                                        Sofia Iyer\n                                    </p>\n                                    <p class=\"mt-0.5 text-[10px]\" data-kid=\"1-1-3-2-6-3-2-1-2-2\" style=\"color:#9ba9ac;\">\n                                        sofia.iyer@example.com\n                                    </p>\n                                </div>\n                            </div>\n                            <span class=\"text-[11px]\" data-kid=\"1-1-3-2-6-3-2-2\" style=\"color:#60777c;\">\n                                17 Aug 2026\n                            </span>\n                            <span class=\"text-[11px]\" data-kid=\"1-1-3-2-6-3-2-3\" style=\"color:#60777c;\">\n                                Spanish · Travel\n                            </span>\n                            <span class=\"flex items-center gap-2\" data-kid=\"1-1-3-2-6-3-2-4\">\n                                <span class=\"h-2 w-2