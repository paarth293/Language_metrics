      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  :root {\n    --slate-950: #172630;\n    --slate-900: #1d303b;\n    --slate-850: #233945;\n    --slate-700: #58717c;\n    --ink: #26343b;\n    --muted: #70818a;\n    --subtle: #9aabb0;\n    --paper: #f4f7f6;\n    --surface: #ffffff;\n    --line: #dce6e5;\n    --teal: #2f988b;\n    --teal-deep: #1e766f;\n    --teal-soft: #e2f1ed;\n    --amber: #b8843b;\n    --amber-soft: #f7ecda;\n    --red: #c46d67;\n    --red-soft: #f9e8e7;\n  }\n  .font-inter { font-family: Inter, ui-sans-serif, system-ui, sans-serif; }\n  .font-mono-lm { font-family: 'JetBrains Mono', ui-monospace, monospace; }\n  .icon-frame { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; }\n  .chart-wrap { position: relative; height: 232px; }\n</style>\n<div class=\"font-inter min-h-[1260px] w-full overflow-hidden\" data-kid=\"1\" data-name=\"admin dashboard page layout\" style=\"background:var(--paper); color:var(--ink);\">\n    <div class=\"flex min-h-[1260px] w-full\" data-kid=\"1-1\" data-name=\"admin dashboard main structure\">\n        <!-- Primary module rail -->\n        <aside class=\"flex w-[88px] shrink-0 flex-col items-center border-r\" data-kid=\"1-1-1\" data-name=\"primary navigation rail\" style=\"background:var(--slate-950); border-color:rgba(255,255,255,.08);\">\n            <div class=\"flex h-[86px] w-full items-center justify-center border-b\" data-kid=\"1-1-1-1\" data-name=\"logo container\" style=\"border-color:rgba(255,255,255,.08);\">\n                <div class=\"icon-frame h-11 w-11 overflow-hidden rounded-[14px] bg-[#f8f4ea] ring-1 ring-white/10\" data-kid=\"1-1-1-1-1\" data-name=\"logo wrapper\">\n                    <img alt=\"Language Metrics logo\" class=\"h-full w-full object-cover\" data-kid=\"1-1-1-1-1-1\" data-name=\"application logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/apps/admin-panel/public/brand/logo-full.png\" style=\"object-position:50% 5%; transform:scale(1.22);\"/>\n                </div>\n            </div>\n            <div class=\"flex w-full flex-1 flex-col items-center gap-3 px-3 py-6\" data-kid=\"1-1-1-2\" data-name=\"navigation item container\">\n                <div class=\"mb-1 flex w-full flex-col items-center gap-1\" data-kid=\"1-1-1-2-1\" data-name=\"workspace label container\">\n                    <span class=\"text-[9px] font-semibold uppercase tracking-[0.2em]\" data-kid=\"1-1-1-2-1-1\" data-name=\"workspace label\" style=\"color:#78909a;\">\n                        Workspace\n                    </span>\n                </div>\n                <div class=\"flex w-full flex-col items-center gap-2\" data-kid=\"1-1-1-2-2\" data-name=\"primary navigation links\">\n                    <div class=\"icon-frame h-[58px] w-[64px] flex-col gap-1 rounded-[15px]\" data-kid=\"1-1-1-2-2-1\" data-name=\"overview link active\" style=\"background:#2b4a55; color:#b5e4dc; box-shadow:inset 0 0 0 1px rgba(181,228,220,.13);\" title=\"Overview\">\n                        <span class=\"icon-frame text-[19px]\" data-kid=\"1-1-1-2-2-1-1\" data-name=\"dashboard icon\" style=\"color:#b5e4dc; width:20px; height:20px;\">\n                            <i class=\"ti ti-layout-dashboard\" data-kid=\"1-1-1-2-2-1-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"text-[10px] font-semibold\" data-kid=\"1-1-1-2-2-1-2\" data-name=\"overview label\">\n                            Overview\n                        </span>\n                    </div>\n                    <div class=\"icon-frame h-[58px] w-[64px] flex-col gap-1 rounded-[15px]\" data-kid=\"1-1-1-2-2-2\" data-name=\"people link\" style=\"color:#8fa5ad;\" title=\"People\">\n                        <span class=\"icon-frame text-[19px]\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"people icon\" style=\"color:#8fa5ad; width:20px; height:20px;\">\n                            <i class=\"ti ti-users\" data-kid=\"1-1-1-2-2-2-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"text-[10px] font-medium\" data-kid=\"1-1-1-2-2-2-2\" data-name=\"people label\">\n                            People\n                        </span>\n                    </div>\n                    <div class=\"icon-frame h-[58px] w-[64px] flex-col gap-1 rounded-[15px]\" data-kid=\"1-1-1-2-2-3\" data-name=\"learning link\" style=\"color:#8fa5ad;\" title=\"Learning\">\n                        <span class=\"icon-frame text-[19px]\" data-kid=\"1-1-1-2-2-3-1\" data-name=\"learning icon\" style=\"color:#8fa5ad; width:20px; height:20px;\">\n                            <i class=\"ti ti-books\" data-kid=\"1-1-1-2-2-3-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"text-[10px] font-medium\" data-kid=\"1-1-1-2-2-3-2\" data-name=\"learning label\">\n                            Learning\n                        </span>\n                    </div>\n                    <div class=\"icon-frame h-[58px] w-[64px] flex-col gap-1 rounded-[15px]\" data-kid=\"1-1-1-2-2-4\" data-name=\"finance link\" style=\"color:#8fa5ad;\" title=\"Finance\">\n                        <span class=\"icon-frame text-[19px]\" data-kid=\"1-1-1-2-2-4-1\" data-name=\"finance icon\" style=\"color:#8fa5ad; width:20px; height:20px;\">\n                            <i class=\"ti ti-wallet\" data-kid=\"1-1-1-2-2-4-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"text-[10px] font-medium\" data-kid=\"1-1-1-2-2-4-2\" data-name=\"finance label\">\n                            Finance\n                        </span>\n                    </div>\n                    <div class=\"icon-frame h-[58px] w-[64px] flex-col gap-1 rounded-[15px]\" data-kid=\"1-1-1-2-2-5\" data-name=\"operations link\" style=\"color:#8fa5ad;\" title=\"Operations\">\n                        <span class=\"icon-frame text-[19px]\" data-kid=\"1-1-1-2-2-5-1\" data-name=\"operations icon\" style=\"color:#8fa5ad; width:20px; height:20px;\">\n                            <i class=\"ti ti-activity\" data-kid=\"1-1-1-2-2-5-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"text-[10px] font-medium\" data-kid=\"1-1-1-2-2-5-2\" data-name=\"operations label\">\n                            Operations\n                        </span>\n                    </div>\n                    <div class=\"icon-frame h-[58px] w-[64px] flex-col gap-1 rounded-[15px]\" data-kid=\"1-1-1-2-2-6\" data-name=\"system link\" style=\"color:#8fa5ad;\" title=\"System\">\n                        <span class=\"icon-frame text-[19px]\" data-kid=\"1-1-1-2-2-6-1\" data-name=\"settings icon\" style=\"color:#8fa5ad; width:20px; height:20px;\">\n                            <i class=\"ti ti-settings\" data-kid=\"1-1-1-2-2-6-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"text-[10px] font-medium\" data-kid=\"1-1-1-2-2-6-2\" data-name=\"system label\">\n                            System\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex w-full flex-col items-center gap-3 border-t px-3 py-5\" data-kid=\"1-1-1-3\" data-name=\"utility action container\" style=\"border-color:rgba(255,255,255,.08);\">\n                <div class=\"icon-frame h-9 w-9 rounded-full\" data-kid=\"1-1-1-3-1\" data-name=\"help button\" style=\"background:#27434e; color:#9bcfc6;\" title=\"Help\">\n                    <span class=\"icon-frame text-[16px]\" data-kid=\"1-1-1-3-1-1\" data-name=\"help icon\" style=\"color:#9bcfc6; width:18px; height:18px;\">\n                        <i class=\"ti ti-help\" data-kid=\"1-1-1-3-1-1-1\">\n                        </i>\n                    </span>\n                </div>\n                <div class=\"icon-frame h-9 w-9 rounded-full\" data-kid=\"1-1-1-3-2\" data-name=\"sign out button\" style=\"color:#8fa5ad;\" title=\"Sign out\">\n                    <span class=\"icon-frame text-[16px]\" data-kid=\"1-1-1-3-2-1\" data-name=\"logout icon\" style=\"color:#8fa5ad; width:18px; height:18px;\">\n                        <i class=\"ti ti-logout\" data-kid=\"1-1-1-3-2-1-1\">\n                        </i>\n                    </span>\n                </div>\n            </div>\n        </aside>\n        <!-- Contextual navigation -->\n        <aside class=\"flex w-[218px] shrink-0 flex-col border-r\" data-kid=\"1-1-2\" data-name=\"secondary contextual navigation\" style=\"background:var(--slate-900); border-color:rgba(255,255,255,.08); color:#d6e1e2;\">\n            <div class=\"flex h-[86px] items-center border-b px-6\" data-kid=\"1-1-2-1\" data-name=\"context header\" style=\"border-color:rgba(255,255,255,.08);\">\n                <div data-kid=\"1-1-2-1-1\" data-name=\"context identity container\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.18em]\" data-kid=\"1-1-2-1-1-1\" data-name=\"product title\" style=\"color:#83b8b2;\">\n                        Language Metrics\n                    </p>\n                    <p class=\"mt-1 text-[12px]\" data-kid=\"1-1-2-1-1-2\" data-name=\"portal type subtitle\" style=\"color:#8fa5ad;\">\n                        Admin Portal\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex-1 px-5 py-8\" data-kid=\"1-1-2-2\" data-name=\"navigation content area\">\n                <div class=\"flex items-center justify-between\" data-kid=\"1-1-2-2-1\" data-name=\"nav title container\">\n                    <span class=\"text-[10px] font-semibold uppercase tracking-[0.2em]\" data-kid=\"1-1-2-2-1-1\" data-name=\"nav section label\" style=\"color:#78909a;\">\n                        Overview\n                    </span>\n                    <span class=\"icon-frame text-[14px]\" data-kid=\"1-1-2-2-1-2\" data-name=\"back arrow icon\" style=\"color:#83b8b2; width:16px; height:16px;\">\n                        <i class=\"ti ti-chevron-left\" data-kid=\"1-1-2-2-1-2-1\">\n                        </i>\n                    </span>\n                </div>\n                <div class=\"mt-5 space-y-1.5\" data-kid=\"1-1-2-2-2\" data-name=\"nav link list\">\n                    <div class=\"flex items-center gap-3 rounded-[10px] px-3 py-2.5\" data-kid=\"1-1-2-2-2-1\" data-name=\"dashboard active link\" style=\"background:#2b4a55; color:#f4fbfa; box-shadow:inset 3px 0 0 #72c5ba;\">\n                        <span class=\"icon-frame text-[16px]\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"dashboard link icon\" style=\"color:#a9dfd6; width:18px; height:18px;\">\n                            <i class=\"ti ti-layout-dashboard\" data-kid=\"1-1-2-2-2-1-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"text-[13px] font-semibold\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"dashboard label\">\n                            Dashboard\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-3 rounded-[10px] px-3 py-2.5\" data-kid=\"1-1-2-2-2-2\" data-name=\"daily brief link\" style=\"color:#9eb0b5;\">\n                        <span class=\"icon-frame text-[16px]\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"daily brief icon\" style=\"color:#78909a; width:18px; height:18px;\">\n                            <i class=\"ti ti-calendar-stats\" data-kid=\"1-1-2-2-2-2-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"text-[13px] font-medium\" data-kid=\"1-1-2-2-2-2-2\" data-name=\"daily brief label\">\n                            Daily brief\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-3 rounded-[10px] px-3 py-2.5\" data-kid=\"1-1-2-2-2-3\" data-name=\"reports link\" style=\"color:#9eb0b5;\">\n                        <span class=\"icon-frame text-[16px]\" data-kid=\"1-1-2-2-2-3-1\" data-name=\"reports icon\" style=\"color:#78909a; width:18px; height:18px;\">\n                            <i class=\"ti ti-file-analytics\" data-kid=\"1-1-2-2-2-3-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"text-[13px] font-medium\" data-kid=\"1-1-2-2-2-3-2\" data-name=\"reports label\">\n                            Reports\n                        </span>\n                    </div>\n                </div>\n                <div class=\"mt-12 border-t pt-7\" data-kid=\"1-1-2-2-3\" data-name=\"quick access section\" style=\"border-color:rgba(255,255,255,.08);\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.2em]\" data-kid=\"1-1-2-2-3-1\" data-name=\"quick access label\" style=\"color:#78909a;\">\n                        Quick access\n                    </p>\n                    <div class=\"mt-4 space-y-4\" data-kid=\"1-1-2-2-3-2\" data-name=\"quick access metrics list\">\n                        <div class=\"flex items-center justify-between text-[12px]\" data-kid=\"1-1-2-2-3-2-1\" data-name=\"pending approvals metric\">\n                            <span data-kid=\"1-1-2-2-3-2-1-1\" style=\"color:#9eb0b5;\">\n                                Pending approvals\n                            </span>\n                            <span class=\"font-mono-lm text-[11px]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-3-2-1-2\" data-name=\"pending approvals count\" data-reason=\"count replaced by script\" style=\"color:#b5e4dc;\">\n                                12\n                            </span>\n                        </div>\n                        <div class=\"flex items-center justify-between text-[12px]\" data-kid=\"1-1-2-2-3-2-2\" data-name=\"open complaints metric\">\n                            <span data-kid=\"1-1-2-2-3-2-2-1\" style=\"color:#9eb0b5;\">\n                                Open complaints\n                            </span>\n                            <span class=\"font-mono-lm text-[11px]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-3-2-2-2\" data-name=\"open complaints count\" data-reason=\"count replaced by script\" style=\"color:#e9c28c;\">\n                                04\n                            </span>\n                        </div>\n                        <div class=\"flex items-center justify-between text-[12px]\" data-kid=\"1-1-2-2-3-2-3\" data-name=\"payout exceptions metric\">\n                            <span data-kid=\"1-1-2-2-3-2-3-1\" style=\"color:#9eb0b5;\">\n                                Payout exceptions\n                            </span>\n                            <span class=\"font-mono-lm text-[11px]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-3-2-3-2\" data-name=\"payout exceptions count\" data-reason=\"count replaced by script\" style=\"color:#e6a4a1;\">\n                                02\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"border-t px-5 py-5\" data-kid=\"1-1-2-3\" data-name=\"session info container\" style=\"border-color:rgba(255,255,255,.08);\">\n                <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-2-3-1\" data-name=\"secure session info\">\n                    <span class=\"icon-frame h-7 w-7 rounded-full\" data-kid=\"1-1-2-3-1-1\" data-name=\"shield check icon\" style=\"background:#2d5a5b; color:#a9dfd6;\">\n                        <span class=\"icon-frame text-[14px]\" data-kid=\"1-1-2-3-1-1-1\" style=\"color:#a9dfd6; width:16px; height:16px;\">\n                            <i class=\"ti ti-shield-check\" data-kid=\"1-1-2-3-1-1-1-1\">\n                            </i>\n                        </span>\n                    </span>\n                    <div data-kid=\"1-1-2-3-1-2\" data-name=\"session text container\">\n                        <p class=\"text-[11px] font-semibold\" data-kid=\"1-1-2-3-1-2-1\" data-name=\"session status label\" style=\"color:#d6e1e2;\">\n                            Secure session\n                        </p>\n                        <p class=\"mt-0.5 text-[10px]\" data-kid=\"1-1-2-3-1-2-2\" data-name=\"session time status\" style=\"color:#78909a;\">\n                            Encrypted · 23 min left\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </aside>\n        <!-- Main workspace -->\n        <main class=\"min-w-0 flex-1\" data-kid=\"1-1-3\" data-name=\"main workspace area\" style=\"background:var(--paper);\">\n            <!-- Utility bar -->\n            <header class=\"flex h-[86px] items-center justify-between border-b px-9\" data-kid=\"1-1-3-1\" data-name=\"top utility bar\" style=\"background:rgba(255,255,255,.78); border-color:var(--line);\">\n                <div class=\"flex w-[430px] items-center gap-3 rounded-[11px] border px-4 py-3\" data-kid=\"1-1-3-1-1\" data-name=\"search input container\" style=\"background:#f8fbfa; border-color:#d8e5e3;\">\n                    <span class=\"icon-frame text-[18px]\" data-kid=\"1-1-3-1-1-1\" data-name=\"search icon\" style=\"color:#7f949a; width:19px; height:19px;\">\n                        <i class=\"ti ti-search\" data-kid=\"1-1-3-1-1-1-1\">\n                        </i>\n                    </span>\n                    <span class=\"text-[13px]\" data-kid=\"1-1-3-1-1-2\" style=\"color:#90a1a5;\">\n                        Search people, classes, payments…\n                    </span>\n                    <span class=\"ml-auto rounded-[6px] border px-1.5 py-0.5 font-mon