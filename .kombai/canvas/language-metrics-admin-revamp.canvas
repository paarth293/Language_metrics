lex items-center justify-between bg-[#fbfdfc] border-t border-[#edf2f0]\" data-kid=\"1-3-2-5-3\">\n                    <div class=\"flex items-center gap-2 text-[10px] text-[#8aa09c]\" data-kid=\"1-3-2-5-3-1\">\n                        <span aria-hidden=\"true\" class=\"text-[14px] text-[#9aadaa] leading-none\" data-kid=\"1-3-2-5-3-1-1\">\n                            <i class=\"ti ti-inbox\" data-kid=\"1-3-2-5-3-1-1-1\">\n                            </i>\n                        </span>\n                        No additional applications in this preview queue.\n                    </div>\n                    <button class=\"text-[10px] font-semibold text-[#3d8e87]\" data-kid=\"1-3-2-5-3-2\">\n                        Browse all teachers\n                        <span aria-hidden=\"true\" data-kid=\"1-3-2-5-3-2-1\">\n                            →\n                        </span>\n                    </button>\n                    <span class=\"ml-auto text-[10px] text-[#9aacaa] ops-mono\" data-kid=\"1-3-2-5-3-3\">\n                        1–3 of 24\n                    </span>\n                </div>\n            </section>\n        </div>\n    </main>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js\">\n</script>\n<script>\n    const canvas = document.getElementById('platformPulseChart');\n  if (canvas && window.Chart) {\n    new Chart(canvas, {\n      type: 'line',\n      data: {\n        labels: ['06 Sep', '07 Sep', '08 Sep', '09 Sep', '10 Sep', '11 Sep', '12 Sep'],\n        datasets: [\n          { label: 'Revenue', data: [28, 34, 31, 43, 40, 51, 58], borderColor: '#2f9188', backgroundColor: 'rgba(47,145,136,.10)', fill: true, tension: .42, pointRadius: 0, borderWidth: 2.5 },\n          { label: 'Classes', data: [22, 28, 27, 35, 33, 39, 44], borderColor: '#b9cfc9', backgroundColor: 'transparent', fill: false, tension: .42, pointRadius: 0, borderWidth: 2 }\n        ]\n      },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        interaction: { intersect: false, mode: 'index' },\n        plugins: { legend: { display: false }, tooltip: { backgroundColor: '#173638', titleColor: '#e8f4f1', bodyColor: '#b9d2cd', padding: 10, displayColors: true, boxPadding: 4 } },\n        scales: {\n          x: { grid: { display: false }, border: { display: false }, ticks: { color: '#9aacaa', font: { family: 'Inter', size: 10 } } },\n          y: { beginAtZero: true, grid: { color: 'rgba(157,181,175,.16)', drawTicks: false }, border: { display: false }, ticks: { color: '#9aacaa', padding: 10, font: { family: 'JetBrains Mono', size: 9 }, callback: (value) => '₹' + value + 'k' } }\n        }\n      }\n    });\n  }\n</script>\n",
