generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// RLS: Public read, self write. Admins full access.
/// Read/Write: Auth webhook writes new users. All apps read.
model User {
  id                           String            @id @db.Uuid
  email                        String            @unique
  role                         UserRole

  // Credentials
  passwordHash                 String?
  /// bcrypt-hashed single-use backup codes
  backupCodes                  String[]          @default([])
  totpEnabled                  Boolean           @default(false)
  /// AES-256-GCM encrypted TOTP secret (base64 payload). Never store plaintext.
  totpSecret                   String?
  /// Optional login handle (admin panel uses username "admin")
  username                     String?           @unique

  /// Email verification — Boolean for simplicity; verified = true
  emailVerified                Boolean           @default(false)
  emailVerificationToken       String?           // bcrypt hash of the one-time token
  emailVerificationTokenPrefix String?           // first 8 chars (plaintext) for fast lookup
  emailVerificationExpiry      DateTime?

  /// Password reset
  passwordResetToken           String?           // bcrypt hash of the one-time token
  passwordResetExpiry          DateTime?

  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  // Profiles
  studentProfile               StudentProfile?
  teacherProfile               TeacherProfile?

  // Relations
  oauthAccounts                OAuthAccount[]
  verificationCodes            EmailVerificationCode[]
  sentMessages                 ChatMessage[]     @relation("SentMessages")
  receivedMessages             ChatMessage[]     @relation("ReceivedMessages")
  coinTransactions             CoinTransaction[]
  payments                     Payment[]
  notifications                Notification[]
  adminLogs                    AdminAuditLog[]
  adminUser                    AdminUser?

  @@index([createdAt])
  @@index([emailVerificationToken])
  @@index([passwordResetToken])
}

/// RLS: Public read. Self write.
/// Read/Write: Student app reads/writes. Teacher/Admin apps read.
model StudentProfile {
  userId             String           @id @db.Uuid
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  name               String
  avatarUrl          String?          // Profile picture URL (from Google or uploaded)
  languageToLearn    String
  proficiencyLevel   ProficiencyLevel
  status             StudentStatus    @default(ACTIVE)
  onboardingComplete Boolean          @default(false)

  // Relations
  bookings           Booking[]
  reviews            Review[]
}

/// RLS: Public read (only approved/active fields). Self write.
/// Read/Write: Teacher app reads/writes. Student app reads. Admin app reads/writes (approvals).
model TeacherProfile {
  userId             String                 @id @db.Uuid
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name               String
  avatarUrl          String?                // Profile picture URL (from Google or uploaded)
  gender             String?
  bio                String?
  experienceLevel    TeacherExperienceLevel
  status             VerificationStatus     @default(PENDING)
  onboardingComplete Boolean                @default(false)

  language           String?
  demoVideoUrl       String?

  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  // Relations
  documents          TeacherDocument[]
  interviews         Interview[]
  rates              TeacherRate[]
  availability       AvailabilitySlot[]
  bookings           Booking[]
  payouts            Payout[]
  reviews            Review[]

  @@index([status])
  @@index([language, status])
}

/// RLS: Owner read/write. Admin read/write. Student no access.
/// Read/Write: Teacher app writes. Admin app reads/updates status.
model TeacherDocument {
  id        String         @id @default(uuid()) @db.Uuid
  teacherId String         @db.Uuid
  type      DocumentType
  url       String
  status    DocumentStatus @default(PENDING)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  teacher   TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
}

/// RLS: Owner read. Admin read/write.
/// Read/Write: Admin app creates/updates. Teacher app reads.
model Interview {
  id          String          @id @default(uuid()) @db.Uuid
  teacherId   String          @db.Uuid
  scheduledAt DateTime
  status      InterviewStatus @default(SCHEDULED)
  meetingLink String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  teacher     TeacherProfile  @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
}

/// RLS: Owner read. Service role only write (via edge functions).
/// Read/Write: Teacher/Admin apps read. Backend/Webhook writes.
model CoinTransaction {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid
  type        CoinTransactionType
  amount      Int
  description String?
  createdAt   DateTime            @default(now())
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// RLS: Public read. Owner write.
/// Read/Write: Teacher app writes. Student app reads for booking.
model AvailabilitySlot {
  id        String         @id @default(uuid()) @db.Uuid
  teacherId String         @db.Uuid
  dayOfWeek Int
  startTime String
  endTime   String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)

  @@index([teacherId, dayOfWeek])
}

/// RLS: Public read. Owner write.
/// Read/Write: Teacher app writes. Student app reads.
model TeacherRate {
  id        String         @id @default(uuid()) @db.Uuid
  teacherId String         @db.Uuid
  type      RateType
  amount    Int
  teacher   TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)

  @@unique([teacherId, type])
}

/// RLS: Participants read. Service role only write (created via payment webhook).
/// Read/Write: Student/Teacher apps read. Backend writes.
model Booking {
  id               String         @id @default(uuid()) @db.Uuid
  studentId        String         @db.Uuid
  teacherId        String         @db.Uuid
  type             BookingType
  status           BookingStatus  @default(PENDING)
  amountPaid       Int
  commissionPct    Int
  commissionAmount Int
  teacherEarnings  Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  student          StudentProfile @relation(fields: [studentId], references: [userId])
  teacher          TeacherProfile @relation(fields: [teacherId], references: [userId])
  sessions         ClassSession[]
  payments         Payment[]
  review           Review?

  @@index([studentId, status])
  @@index([teacherId, status])
  @@index([status])
}

/// RLS: Participants read. Backend updates status/recording.
/// Read/Write: Student/Teacher apps read. Backend writes (LiveKit webhook).
model ClassSession {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @db.Uuid
  scheduledStart  DateTime
  scheduledEnd    DateTime
  actualStart     DateTime?
  actualEnd       DateTime?
  status          SessionStatus @default(SCHEDULED)
  recordingUrl    String?
  isRecordingPaid Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([scheduledStart])
  @@index([status, scheduledStart])
}

/// RLS: Owner read. Service role only write (payment gateway webhooks).
/// Read/Write: Admin app reads all. User apps read own. Backend writes.
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  bookingId         String?       @db.Uuid
  type              PaymentType
  amount            Int
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  booking           Booking?      @relation(fields: [bookingId], references: [id])
  user              User          @relation(fields: [userId], references: [id])

  @@index([status])
}

/// RLS: Owner read. Admin read/write.
/// Read/Write: Teacher app reads. Admin app reads/writes.
model Payout {
  id             String         @id @default(uuid()) @db.Uuid
  teacherId      String         @db.Uuid
  amount         Int
  status         PayoutStatus   @default(PENDING)
  periodStart    DateTime
  periodEnd      DateTime
  transactionRef String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  teacher        TeacherProfile @relation(fields: [teacherId], references: [userId])

  @@index([status])
  @@index([createdAt])
}

/// RLS: Sender/Receiver read/write. Admin read (moderation).
/// Read/Write: Student/Teacher apps read/write. Admin app reads.
model ChatMessage {
  id            String   @id @default(uuid()) @db.Uuid
  senderId      String   @db.Uuid
  receiverId    String   @db.Uuid
  content       String
  attachmentUrl String?
  autoDeleteAt  DateTime
  createdAt     DateTime @default(now())
  receiver      User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender        User     @relation("SentMessages", fields: [senderId], references: [id])

  @@index([senderId, receiverId])
  @@index([autoDeleteAt])
}

/// RLS: Public read. Owner (Student) write.
/// Read/Write: Student app writes. Teacher app reads.
model Review {
  id        String         @id @default(uuid()) @db.Uuid
  bookingId String         @unique @db.Uuid
  studentId String         @db.Uuid
  teacherId String         @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime       @default(now())
  booking   Booking        @relation(fields: [bookingId], references: [id])
  student   StudentProfile @relation(fields: [studentId], references: [userId])
  teacher   TeacherProfile @relation(fields: [teacherId], references: [userId])

  @@index([teacherId, rating])
}

/// RLS: Owner read/write.
/// Read/Write: All apps read own. Backend creates.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// RLS: Public read. Admin only write.
/// Read/Write: Admin app writes. All apps read.
model PlatformSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

/// RLS: Admin only read/write.
/// Read/Write: Admin app reads. Admin app / Backend writes.
/// Column names are snake_case to match security-tests/test_audit_log.py.
model AdminAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  /// User UUID when known; attempted username on failed login
  actorId   String?  @map("actor_id")
  adminId   String?  @map("admin_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  /// e.g. LOGIN_SUCCESS, LOGIN_FAILURE, LOGOUT, APPROVE_TEACHER
  eventType String   @default("UNKNOWN") @map("event_type")
  ipAddress String?  @map("ip_address")
  /// "success" | "failure"
  outcome   String?
  userAgent String?  @map("user_agent")
  admin     User?    @relation(fields: [adminId], references: [id])
}

/// Admin panel credential store. Linked to a User row (which mirrors
/// Supabase auth.users.id) so audit logs keep referential integrity.
/// Password hashes are bcrypt; never stored in plain text.
model AdminUser {
  userId             String          @id @db.Uuid
  name               String
  email              String          @unique
  passwordHash       String
  roleKey            String
  isSuperAdmin       Boolean         @default(false)
  permissions        String[]
  status             AdminUserStatus @default(ACTIVE)
  mustChangePassword Boolean         @default(false)
  lastLoginAt        DateTime?
  failedLoginCount   Int             @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  email       String
  ip          String?
  result      String
  adminUserId String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([ip])
}

/// Non-repudiation / monitoring events surfaced in Security & Monitoring.
model SecurityEvent {
  id          String   @id @default(uuid()) @db.Uuid
  type        String
  severity    String   @default("INFO")
  actorUserId String?  @db.Uuid
  details     String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model Language {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @unique
  code      String         @unique
  flagEmoji String?
  iconUrl   String?
  levels    Int            @default(6)
  status    LanguageStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  courses   Course[]
}

model Course {
  id               String       @id @default(uuid()) @db.Uuid
  languageId       String       @db.Uuid
  name             String
  level            String
  description      String?
  syllabus         String?
  price            Int
  durationWeeks    Int
  classCount       Int
  classDurationMin Int
  status           CourseStatus @default(DRAFT)
  published        Boolean      @default(false)
  teacherIds       String[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  language         Language     @relation(fields: [languageId], references: [id])

  @@index([languageId])
  @@index([published])
}

model Coupon {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique
  discountType  CouponDiscountType
  discountValue Int
  scope         CouponScope        @default(GLOBAL)
  scopeTargetId String?
  minOrderValue Int                @default(0)
  maxUses       Int?
  usedCount     Int                @default(0)
  expiresAt     DateTime?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  invoiceNumber    String        @unique
  orderId          String        @unique
  userId           String        @db.Uuid
  billingType      BillingType   @default(B2C)
  customerGstin    String?
  grossAmount      Int
  cgstPct          Int
  sgstPct          Int
  igstPct          Int
  taxAmount        Int
  totalAmount      Int
  status           InvoiceStatus @default(ISSUED)
  pdfUrl           String?
  creditNoteNumber String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Complaint {
  id            String            @id @default(uuid()) @db.Uuid
  ticketNumber  String            @unique
  studentId     String?           @db.Uuid
  teacherId     String?           @db.Uuid
  bookingId     String?           @db.Uuid
  category      ComplaintCategory @default(OTHER)
  subject       String
  description   String
  status        ComplaintStatus   @default(NEW)
  severity      String            @default("MEDIUM")
  assignedTo    String?           @db.Uuid
  internalNotes String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([ticketNumber])
}

model NotificationTemplate {
  id         String              @id @default(uuid()) @db.Uuid
  name       String
  channel    NotificationChannel
  title      String
  body       String
  audience   String
  isActive   Boolean             @default(true)
  lastSentAt DateTime?
  createdAt  DateTime            @default(now())
}

model CmsContent {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  contentType String
  content     String
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([expiresAt])
}

/// OAuth provider accounts linked to a User.
/// A single User can have multiple OAuth accounts (one per provider).
model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum TeacherExperienceLevel {
  FRESHER
  EXPERIENCED
}

enum VerificationStatus {
  PENDING
  INTERVIEW_SCHEDULED
  APPROVED
  REJECTED
}

enum DocumentType {
  EDUCATION
  LANGUAGE_CERTIFICATE
  EXPERIENCE_LETTER
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CoinTransactionType {
  PURCHASE
  BONUS
  SPEND
  REFUND
}

enum RateType {
  HOURLY
  COURSE
}

enum BookingType {
  DEMO
  HOURLY
  COURSE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentType {
  BOOKING
  COIN_PURCHASE
  REGISTRATION_FEE
  RECORDING_FEE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum NotificationType {
  SYSTEM
  BOOKING_UPDATE
  PAYMENT_UPDATE
  CHAT_MESSAGE
  VERIFICATION_UPDATE
}

enum AdminUserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum LanguageStatus {
  ACTIVE
  INACTIVE
}

enum CourseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponScope {
  GLOBAL
  LANGUAGE
  COURSE
  FIRST_STUDENT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
  CREDIT_NOTE
}

enum BillingType {
  B2B
  B2C
}

enum ComplaintStatus {
  NEW
  INVESTIGATING
  ACTION_REQUIRED
  RESOLVED
  CLOSED
}

enum ComplaintCategory {
  CONTACT_SHARING
  TEACHER_BEHAVIOUR
  PAYMENT
  REFUND
  OTHER
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  INAPP
}
