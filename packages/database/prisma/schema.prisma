generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// RLS: Public read, self write. Admins full access.
/// Read/Write: Auth webhook writes new users. All apps read.
model User {
  email                        String                  @unique
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  id                           String                  @id @db.Uuid
  role                         UserRole
  /// bcrypt-hashed single-use backup codes
  backupCodes                  String[]                @default([])
  passwordHash                 String?
  totpEnabled                  Boolean                 @default(false)
  /// AES-256-GCM encrypted TOTP secret (base64 payload). Never store plaintext.
  totpSecret                   String?
  /// Optional login handle (admin panel uses username "admin")
  username                     String?                 @unique
  emailVerificationExpiry      DateTime?
  emailVerificationToken       String?
  passwordResetExpiry          DateTime?
  /// Password reset
  passwordResetToken           String?
  emailVerificationTokenPrefix String?
  /// Email verification — Boolean for simplicity; verified = true
  emailVerified                Boolean                 @default(false)
  adminLogs                    AdminAuditLog[]
  adminUser                    AdminUser?
  receivedMessages             ChatMessage[]           @relation("ReceivedMessages")
  sentMessages                 ChatMessage[]           @relation("SentMessages")
  coinTransactions             CoinTransaction[]
  verificationCodes            EmailVerificationCode[]
  notifications                Notification[]
  oauthAccounts                OAuthAccount[]
  payments                     Payment[]
  studentProfile               StudentProfile?
  teacherProfile               TeacherProfile?
  deviceTokens                 DeviceToken[]
  razorpayOrders               RazorpayOrder[]
  coinAccount                  CoinAccount?
  liveSessions                 LiveParticipantSession[]

  @@index([createdAt])
  @@index([emailVerificationToken])
  @@index([passwordResetToken])
}

/// RLS: Public read. Self write.
/// Read/Write: Student app reads/writes. Teacher/Admin apps read.
model StudentProfile {
  userId             String        @id @db.Uuid
  name               String
  languageToLearn    String
  status             StudentStatus @default(ACTIVE)
  avatarUrl          String?
  onboardingComplete Boolean       @default(false)
  proficiencyLevel   String        @default("A1")
  bookings           Booking[]
  reviews            Review[]
  sessionBillings    SessionBilling[]
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// RLS: Public read (only approved/active fields). Self write.
/// Read/Write: Teacher app reads/writes. Student app reads. Admin app reads/writes (approvals).
model TeacherProfile {
  userId             String                 @id @db.Uuid
  name               String
  gender             String?
  bio                String?
  experienceLevel    TeacherExperienceLevel
  status             VerificationStatus     @default(PENDING)
  language           String?
  demoVideoUrl       String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  avatarUrl          String?
  onboardingComplete Boolean                @default(false)
  languages          String[]               @default([])
  availability       AvailabilitySlot[]
  bookings           Booking[]
  interviews         Interview[]
  payouts            Payout[]
  reviews            Review[]
  sessionBillings    SessionBilling[]
  documents          TeacherDocument[]
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rates              TeacherRate[]

  @@index([status])
  @@index([language, status])
}

/// RLS: Owner read/write. Admin read/write. Student no access.
/// Read/Write: Teacher app writes. Admin app reads/updates status.
model TeacherDocument {
  id        String         @id @default(uuid()) @db.Uuid
  teacherId String         @db.Uuid
  type      DocumentType
  url       String
  status    DocumentStatus @default(PENDING)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  teacher   TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
}

/// RLS: Owner read. Admin read/write.
/// Read/Write: Admin app creates/updates. Teacher app reads.
model Interview {
  id          String          @id @default(uuid()) @db.Uuid
  teacherId   String          @db.Uuid
  scheduledAt DateTime
  status      InterviewStatus @default(SCHEDULED)
  meetingLink String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  teacher     TeacherProfile  @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
}

/// RLS: Owner read. Service role only write (via edge functions).
/// Read/Write: Teacher/Admin apps read. Backend/Webhook writes.
model CoinTransaction {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid
  type        CoinTransactionType
  amount      Int
  description String?
  createdAt   DateTime            @default(now())
  /// Caller-supplied de-duplication key. A retried webhook or a double-clicked
  /// button reuses the same key and the second write is rejected by the unique
  /// index rather than double-charging.
  idempotencyKey String?          @unique
  /// Spendable balance immediately after this row was written. Makes the
  /// ledger auditable without replaying every prior transaction.
  balanceAfter   Int?
  /// What this movement was for, when it relates to a class.
  classSessionId String?          @db.Uuid
  bookingId      String?          @db.Uuid
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([classSessionId])
  @@index([bookingId])
}

/// Materialised coin balance.
///
/// Exists because summing every CoinTransaction on each read is O(n) in a
/// table that only grows, and because "read the balance, then write a debit"
/// is a lost-update race the moment two requests overlap. Debits here are a
/// single conditional UPDATE, which Postgres serialises for us.
model CoinAccount {
  userId         String   @id @db.Uuid
  /// Coins the user can spend right now.
  balance        Int      @default(0)
  /// Coins reserved against upcoming classes. Not spendable, not yet spent.
  heldBalance    Int      @default(0)
  lifetimeEarned Int      @default(0)
  lifetimeSpent  Int      @default(0)
  /// Incremented on every mutation. Lets callers detect concurrent writes.
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([balance])
}

/// RLS: Public read. Owner write.
/// Read/Write: Teacher app writes. Student app reads for booking.
model AvailabilitySlot {
  id        String         @id @default(uuid()) @db.Uuid
  teacherId String         @db.Uuid
  dayOfWeek Int
  startTime String
  endTime   String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)

  @@index([teacherId, dayOfWeek])
}

/// RLS: Public read. Owner write.
/// Read/Write: Teacher app writes. Student app reads.
model TeacherRate {
  id        String         @id @default(uuid()) @db.Uuid
  teacherId String         @db.Uuid
  type      RateType
  amount    Int
  teacher   TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)

  @@unique([teacherId, type])
}

/// RLS: Participants read. Service role only write (created via payment webhook).
/// Read/Write: Student/Teacher apps read. Backend writes.
model Booking {
  id               String         @id @default(uuid()) @db.Uuid
  studentId        String         @db.Uuid
  teacherId        String         @db.Uuid
  type             BookingType
  status           BookingStatus  @default(PENDING)
  amountPaid       Int
  commissionPct    Int
  commissionAmount Int
  teacherEarnings  Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  student          StudentProfile @relation(fields: [studentId], references: [userId])
  teacher          TeacherProfile @relation(fields: [teacherId], references: [userId])
  sessions         ClassSession[]
  payments         Payment[]
  review           Review?

  @@index([studentId, status])
  @@index([teacherId, status])
  @@index([status])
}

/// RLS: Participants read. Backend updates status/recording.
/// Read/Write: Student/Teacher apps read. Backend writes (LiveKit webhook).
model ClassSession {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @db.Uuid
  scheduledStart  DateTime
  scheduledEnd    DateTime
  actualStart     DateTime?
  actualEnd       DateTime?
  status          SessionStatus @default(SCHEDULED)
  recordingUrl    String?
  isRecordingPaid Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // ── LiveKit room lifecycle ────────────────────────────────────────────
  /// Always `class-<id>`. Stored so webhooks can be matched without parsing.
  lkRoomName      String?
  /// LiveKit's own room id, unique per room *instance*. A room that empties
  /// and is recreated gets a new sid, which is how we detect a rejoin.
  lkRoomSid       String?
  lkEgressId      String?
  qualityProfile  String        @default("low")

  // ── Metering ──────────────────────────────────────────────────────────
  /// Seconds the student and a teacher were both connected. What we bill.
  billableSeconds Int           @default(0)
  /// Sum of every participant's connected seconds. What LiveKit bills us.
  connectionSeconds Int         @default(0)
  /// Estimated downstream bytes, for the cost dashboard.
  downstreamBytes BigInt        @default(0)
  noShow          NoShowParty   @default(NONE)

  // ── Recording ─────────────────────────────────────────────────────────
  recordingStatus   RecordingStatus @default(NONE)
  recordingMode     RecordingMode?
  recordingDurationSeconds Int?
  recordingSizeBytes BigInt?
  recordingError    String?

  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  participants    LiveParticipantSession[]
  billing         SessionBilling?

  @@index([bookingId])
  @@index([scheduledStart])
  @@index([status, scheduledStart])
  @@index([lkRoomName])
  @@index([recordingStatus])
}

/// One row per (participant, connection). A user who drops and rejoins three
/// times produces three rows, which is exactly what the billing intersection
/// needs in order to not charge them for the gaps.
model LiveParticipantSession {
  id               String              @id @default(uuid()) @db.Uuid
  classSessionId   String              @db.Uuid
  userId           String              @db.Uuid
  role             LiveParticipantRole
  /// LiveKit participant identity (equals userId for participants we mint).
  identity         String
  /// LiveKit participant sid — unique per connection, our idempotency anchor.
  participantSid   String?             @unique
  joinedAt         DateTime
  leftAt           DateTime?
  durationSeconds  Int                 @default(0)
  disconnectReason String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  classSession     ClassSession        @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([classSessionId, role])
  @@index([userId, joinedAt])
  @@index([leftAt])
}

/// The money record for one class. Separate from ClassSession so a settlement
/// can be recomputed and re-audited without touching session state.
model SessionBilling {
  classSessionId  String               @id @db.Uuid
  studentId       String               @db.Uuid
  teacherId       String               @db.Uuid
  /// Coins reserved at booking time.
  heldCoins       Int
  coinsPerMinute  Int
  /// Minutes the student was actually taught.
  billedMinutes   Int                  @default(0)
  chargedCoins    Int                  @default(0)
  refundedCoins   Int                  @default(0)
  overageCoins    Int                  @default(0)
  status          SessionBillingStatus @default(HELD)
  /// Teacher no-show and similar cases an admin should look at.
  requiresReview  Boolean              @default(false)
  reason          String?
  settledAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  /// These are financial records, so every relation restricts rather than
  /// cascades: a settled billing row must never disappear as a side effect of
  /// deleting something upstream. Nothing in the codebase deletes ClassSession,
  /// Booking, User or either profile, so RESTRICT blocks no existing flow.
  classSession    ClassSession         @relation(fields: [classSessionId], references: [id], onDelete: Restrict)
  /// studentId/teacherId are the same values Booking carries, so they point at
  /// the profile rows (keyed on userId), not at User directly.
  student         StudentProfile       @relation(fields: [studentId], references: [userId], onDelete: Restrict)
  teacher         TeacherProfile       @relation(fields: [teacherId], references: [userId], onDelete: Restrict)

  @@index([status])
  @@index([studentId])
  @@index([teacherId])
  @@index([requiresReview])
}

/// Webhook de-duplication for every provider, not just LiveKit.
///
/// LiveKit retries a webhook until it gets a 2xx, so the same event WILL
/// arrive more than once. Without this table a retried `participant_left`
/// settles the same class twice.
model WebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  source      String
  eventId     String
  eventType   String
  /// Set once processing succeeds. A row with a null value was seen but not
  /// completed, which is the signal to retry rather than skip.
  processedAt DateTime?
  error       String?
  receivedAt  DateTime @default(now())

  @@unique([source, eventId])
  @@index([source, eventType, receivedAt])
}

/// Daily LiveKit consumption, for the admin cost dashboard and budget guard.
/// Keyed by YYYY-MM-DD so a day can be upserted without a range query.
model LiveKitUsageDaily {
  day                    String   @id
  connectionSeconds      Int      @default(0)
  participantSessions    Int      @default(0)
  egressVideoSeconds     Int      @default(0)
  egressAudioSeconds     Int      @default(0)
  downstreamBytes        BigInt   @default(0)
  classSessions          Int      @default(0)
  updatedAt              DateTime @updatedAt
}

/// RLS: Owner read. Service role only write (payment gateway webhooks).
/// Read/Write: Admin app reads all. User apps read own. Backend writes.
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  bookingId         String?       @db.Uuid
  type              PaymentType
  amount            Int
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  booking           Booking?      @relation(fields: [bookingId], references: [id])
  user              User          @relation(fields: [userId], references: [id])

  @@index([status])
}

/// RLS: Owner read. Admin read/write.
/// Read/Write: Teacher app reads. Admin app reads/writes.
model Payout {
  id             String         @id @default(uuid()) @db.Uuid
  teacherId      String         @db.Uuid
  amount         Int
  status         PayoutStatus   @default(PENDING)
  periodStart    DateTime
  periodEnd      DateTime
  transactionRef String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  teacher        TeacherProfile @relation(fields: [teacherId], references: [userId])

  @@index([status])
  @@index([createdAt])
}

/// RLS: Sender/Receiver read/write. Admin read (moderation).
/// Read/Write: Student/Teacher apps read/write. Admin app reads.
model ChatMessage {
  id            String   @id @default(uuid()) @db.Uuid
  senderId      String   @db.Uuid
  receiverId    String   @db.Uuid
  content       String
  attachmentUrl String?
  autoDeleteAt  DateTime
  createdAt     DateTime @default(now())
  receiver      User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender        User     @relation("SentMessages", fields: [senderId], references: [id])

  @@index([senderId, receiverId])
  @@index([autoDeleteAt])
}

/// RLS: Public read. Owner (Student) write.
/// Read/Write: Student app writes. Teacher app reads.
model Review {
  id        String         @id @default(uuid()) @db.Uuid
  bookingId String         @unique @db.Uuid
  studentId String         @db.Uuid
  teacherId String         @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime       @default(now())
  booking   Booking        @relation(fields: [bookingId], references: [id])
  student   StudentProfile @relation(fields: [studentId], references: [userId])
  teacher   TeacherProfile @relation(fields: [teacherId], references: [userId])

  @@index([teacherId, rating])
}

/// RLS: Owner read/write.
/// Read/Write: All apps read own. Backend creates.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// RLS: Public read. Admin only write.
/// Read/Write: Admin app writes. All apps read.
model PlatformSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

/// RLS: Admin only read/write.
/// Read/Write: Admin app reads. Admin app / Backend writes.
/// Column names are snake_case to match security-tests/test_audit_log.py.
model AdminAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  /// User UUID when known; attempted username on failed login
  actorId   String?  @map("actor_id")
  adminId   String?  @map("admin_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  /// e.g. LOGIN_SUCCESS, LOGIN_FAILURE, LOGOUT, APPROVE_TEACHER
  eventType String   @default("UNKNOWN") @map("event_type")
  ipAddress String?  @map("ip_address")
  /// "success" | "failure"
  outcome   String?
  userAgent String?  @map("user_agent")
  admin     User?    @relation(fields: [adminId], references: [id])
}

/// Admin panel credential store. Linked to a User row (which mirrors
/// Supabase auth.users.id) so audit logs keep referential integrity.
/// Password hashes are bcrypt; never stored in plain text.
model AdminUser {
  userId             String          @id @db.Uuid
  name               String
  email              String          @unique
  passwordHash       String
  roleKey            String
  isSuperAdmin       Boolean         @default(false)
  permissions        String[]
  status             AdminUserStatus @default(ACTIVE)
  mustChangePassword Boolean         @default(false)
  lastLoginAt        DateTime?
  failedLoginCount   Int             @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  email       String
  ip          String?
  result      String
  adminUserId String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([ip])
}

/// Non-repudiation / monitoring events surfaced in Security & Monitoring.
model SecurityEvent {
  id          String   @id @default(uuid()) @db.Uuid
  type        String
  severity    String   @default("INFO")
  actorUserId String?  @db.Uuid
  details     String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model Language {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @unique
  code      String         @unique
  flagEmoji String?
  iconUrl   String?
  levels    Int            @default(6)
  status    LanguageStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  courses   Course[]
}

model Course {
  id               String       @id @default(uuid()) @db.Uuid
  languageId       String       @db.Uuid
  name             String
  level            String
  description      String?
  syllabus         String?
  price            Int
  durationWeeks    Int
  classCount       Int
  classDurationMin Int
  status           CourseStatus @default(DRAFT)
  published        Boolean      @default(false)
  teacherIds       String[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  language         Language     @relation(fields: [languageId], references: [id])

  @@index([languageId])
  @@index([published])
}

model Coupon {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique
  discountType  CouponDiscountType
  discountValue Int
  scope         CouponScope        @default(GLOBAL)
  scopeTargetId String?
  minOrderValue Int                @default(0)
  maxUses       Int?
  usedCount     Int                @default(0)
  expiresAt     DateTime?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  invoiceNumber    String        @unique
  orderId          String        @unique
  userId           String        @db.Uuid
  billingType      BillingType   @default(B2C)
  customerGstin    String?
  grossAmount      Int
  cgstPct          Int
  sgstPct          Int
  igstPct          Int
  taxAmount        Int
  totalAmount      Int
  status           InvoiceStatus @default(ISSUED)
  pdfUrl           String?
  creditNoteNumber String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Complaint {
  id            String            @id @default(uuid()) @db.Uuid
  ticketNumber  String            @unique
  studentId     String?           @db.Uuid
  teacherId     String?           @db.Uuid
  bookingId     String?           @db.Uuid
  category      ComplaintCategory @default(OTHER)
  subject       String
  description   String
  status        ComplaintStatus   @default(NEW)
  severity      String            @default("MEDIUM")
  assignedTo    String?           @db.Uuid
  internalNotes String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([ticketNumber])
}

model NotificationTemplate {
  id         String              @id @default(uuid()) @db.Uuid
  name       String
  channel    NotificationChannel
  title      String
  body       String
  audience   String
  isActive   Boolean             @default(true)
  lastSentAt DateTime?
  createdAt  DateTime            @default(now())
}

model CmsContent {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  contentType String
  content     String
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// OAuth provider accounts linked to a User.
/// A single User can have multiple OAuth accounts (one per provider).
model OAuthAccount {
  userId            String   @db.Uuid
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  createdAt         DateTime @default(now())
  id                String   @id @default(uuid()) @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum TeacherExperienceLevel {
  FRESHER
  EXPERIENCED
}

enum VerificationStatus {
  PENDING
  INTERVIEW_SCHEDULED
  APPROVED
  REJECTED
}

enum DocumentType {
  EDUCATION
  LANGUAGE_CERTIFICATE
  EXPERIENCE_LETTER
  OTHER
  ID_PROOF
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CoinTransactionType {
  PURCHASE
  BONUS
  SPEND
  REFUND
  /// Coins moved from spendable to held when a class is booked.
  HOLD
  /// Held coins returned to spendable without being spent.
  HOLD_RELEASE
  /// Manual correction by an admin. Always carries a description.
  ADJUSTMENT
}

enum LiveParticipantRole {
  TEACHER
  STUDENT
  OBSERVER
}

enum NoShowParty {
  NONE
  TEACHER
  STUDENT
  BOTH
}

enum SessionBillingStatus {
  /// Coins reserved, class not yet finished.
  HELD
  /// Measured and charged.
  SETTLED
  /// Fully refunded (teacher no-show, cancellation).
  REFUNDED
  /// Settlement failed and needs a human.
  FAILED
}

enum RecordingStatus {
  NONE
  REQUESTED
  RECORDING
  PROCESSING
  AVAILABLE
  FAILED
}

enum RecordingMode {
  AUDIO
  VIDEO
}

enum RateType {
  HOURLY
  COURSE
}

enum BookingType {
  DEMO
  HOURLY
  COURSE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentType {
  BOOKING
  COIN_PURCHASE
  REGISTRATION_FEE
  RECORDING_FEE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum NotificationType {
