{
  "name": "language-learning-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w teacher-web\" \"npm run dev -w admin-panel\" \"npm run dev -w student-web\"",
    "dev:teacher": "npm run dev -w teacher-web",
    "dev:admin": "npm run dev -w admin-panel",
    "dev:student": "npm run dev -w student-web",
    "start": "concurrently \"npm start -w teacher-web\" \"npm start -w admin-panel\" \"npm start -w student-web\"",
    "build": "npx prisma@5 generate --schema=packages/database/prisma/schema.prisma && npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "setup": "husky",
    "postinstall": "npm run postinstall --workspaces --if-present",
    "db:seed": "node --env-file=.env packages/database/prisma/seed.mjs",
    "scan:sast": "semgrep --config p/owasp-top-ten --config p/nextjs --config p/secrets --config semgrep.yml --json --output sast-results.json apps/admin-panel/src/ && node security-tests/generate-sast-report.mjs",
    "scan:deps": "npm audit --json > npm-audit.json; echo 'npm audit done — see npm-audit.json'",
    "scan:secrets": "gitleaks detect --config .gitleaks.toml --source . --verbose",
    "test:security": "python security-tests/run_all.py"
  },
  "prisma": {
    "seed": "node --env-file=.env packages/database/prisma/seed.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@prisma/client": "^5.22.0",
    "@smithy/core": "^3.33.3",
    "@smithy/types": "^4.17.2",
    "@supabase/supabase-js": "^2.112.4",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.22.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-no-secrets": "^1.1.2",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.8",
    "prisma": "^5.22.0",
    "tailwindcss": "^4"
  },
  "lint-staged": {
    "apps/teacher-web/**/*.{js,jsx,ts,tsx}": [
      "eslint --config apps/teacher-web/eslint.config.mjs --fix"
    ],
    "apps/admin-panel/**/*.{js,jsx,ts,tsx}": [
      "eslint --config apps/admin-panel/eslint.config.mjs --fix"
    ]
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  }
}
