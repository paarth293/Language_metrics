{
  "name": "language-learning-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w language_metrics\" \"npm run dev -w admin-panel\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "setup": "husky",
    "postinstall": "npm run postinstall --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.8"
  },
  "lint-staged": {
    "apps/teacher-web/**/*.{js,jsx,ts,tsx}": [
      "eslint --config apps/teacher-web/eslint.config.mjs --fix"
    ]
  }
}
