{
  "name": "language-learning-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "setup": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.4",
    "lint-staged": "^15.2.8"
  },
  "lint-staged": {
    "apps/teacher-web/**/*.{js,jsx,ts,tsx}": [
      "eslint --config apps/teacher-web/eslint.config.mjs --fix"
    ]
  }
}
