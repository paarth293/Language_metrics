# =============================================================================
# Language Metrics — .gitignore
# =============================================================================

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*

# ── Build output ──────────────────────────────────────────────────────────────
.next/
out/
build/
dist/
.expo/
*.tsbuildinfo
**/next-env.d.ts

# ── Prisma generated client ───────────────────────────────────────────────────
prisma/generated/

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# ── OS generated files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Editor, IDE & local tooling ───────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.kombai/
*.sw?
*~

# ── AI agent files (regenerated locally by `next dev`) ────────────────────────
apps/*/AGENTS.md
apps/*/CLAUDE.md

# ── Testing & coverage ────────────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/

# ── Security scan output (generated by `npm run scan:*` / CI) ─────────────────
SECURITY_REPORT.md
sast-results.json
npm-audit.json
osv-results.json
eslint-security-results.json
tests/security/*.txt
!tests/security/requirements.txt
__pycache__/
*.pyc

# ── Test artifacts & session cookies ──────────────────────────────────────────
cookie.txt
login_response.json
*.cookiejar

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ── Deployment ────────────────────────────────────────────────────────────────
.vercel/
.netlify/

# ── Runtime uploads & scratch work ────────────────────────────────────────────
**/public/uploads/
scratch/

# ── Misc ──────────────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.turbo/
*.tgz
*.tar.gz
*.bundle

# ── SQL dumps (Prisma migrations must still be committed) ─────────────────────
*.sql
!packages/database/prisma/migrations/**/migration.sql
