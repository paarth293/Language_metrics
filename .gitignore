# =============================================================================
# Language Metrics — .gitignore
# Industry-standard patterns for a Next.js + Prisma + PostgreSQL production repo
# =============================================================================

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ──────────────────────────────────────────────────────
.next/
out/
build/
dist/

# ── Prisma generated client (regenerated via `npx prisma generate`) ───────────
prisma/generated/

# ── Environment & secrets ──────────────────────────────────────────────────────
# Never commit ANY .env file except the safe example template
.env
.env.*
!.env.example

# ── OS generated files ─────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Editor & IDE ───────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ── Testing & coverage ─────────────────────────────────────────────────────────
/coverage
.nyc_output
test-results/
playwright-report/
playwright/.cache/

# ── Logs ───────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── Deployment ─────────────────────────────────────────────────────────────────
.vercel
.netlify

# ── Certificates & keys ────────────────────────────────────────────────────────
*.pem
*.key
*.cert
*.crt
*.p12

# ── Internal documentation (not for contributors, lives in private wiki) ───────
docs/internal/

# ── AI agent instruction files (tooling-only, not for contributors) ────────────
AGENTS.md
CLAUDE.md

